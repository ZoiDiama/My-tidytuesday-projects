# Scurvy
# TidyTuesday 2023 · Week 30
# Question: which of Lind's six treatments actually worked?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
scurvy <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2023/2023-07-25/scurvy.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
symptoms <- c(gum_rot_d6 = "Gum rot", skin_sores_d6 = "Skin sores",
              weakness_of_the_knees_d6 = "Weak knees", lassitude_d6 = "Fatigue")

treat_lab <- c(citrus = "2 lemons + 1 orange", cider = "Cider",
               dilute_sulfuric_acid = "Dilute sulfuric acid", vinegar = "Vinegar",
               sea_water = "Sea water", purgative_mixture = "Purgative paste")

dt <- scurvy |>
  pivot_longer(names(symptoms), names_to = "symptom", values_to = "score") |>
  mutate(score   = as.integer(str_sub(score, 1, 1)),
         symptom = factor(symptoms[symptom], levels = symptoms),
         fit     = fit_for_duty_d6 == "1_yes")

# Rank treatments from best (lowest total severity) to worst
rank <- dt |> group_by(treatment) |> summarise(total = sum(score)) |>
  arrange(total, treatment) |> pull(treatment)

dt <- dt |>
  mutate(treatment = factor(treatment, levels = rank)) |>
  arrange(treatment, study_id) |>
  # one row per sailor, a small gap between treatments, best treatment on top
  mutate(t = as.integer(treatment),
         pos = as.integer(factor(study_id, levels = unique(study_id))),
         y = -(pos + (t - 1) * 0.35),
         x = as.integer(symptom))

n_fit <- dt |> distinct(study_id, fit) |> filter(fit) |> nrow()

# 4. COLOURS & TEXT --------------------------------------------------------
sev_cols <- c(`0` = "#2E9E5B", `1` = "#A8D5A2", `2` = "#F4B860", `3` = "#D7443E")
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- "Citrus was the only treatment that cured scurvy in Lind's 1747 trial"

st <- paste0(
  "In 1747 James Lind gave 12 sailors with scurvy six different treatments, two sailors each. ",
  "After six days, symptoms were scored ",
  "<span style='color:", sev_cols["0"], "'>**none**</span>, ",
  "<span style='color:#6FAF68'>**mild**</span>, ",
  "<span style='color:#E39A2D'>**moderate**</span> or ",
  "<span style='color:", sev_cols["3"], "'>**severe**</span>. ",
  "Each row is one sailor; treatments are ranked from best to worst.")

ct <- paste0("Data source: {medicaldata} R package, Scurvy dataset",
             " · Creator: Zoi Diamantakou · TidyTuesday 2023 · Week 30")

# Treatment labels: one per pair of sailors, on the y axis
treat_pos <- dt |> group_by(treatment) |> summarise(y = mean(y)) |>
  mutate(label = treat_lab[as.character(treatment)],
         label = if_else(treatment == rank[1], paste0("**", label, "**"), label))

fit_pos <- dt |> distinct(y, fit) |> filter(fit)

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(x, y)) +
  geom_tile(aes(fill = factor(score)), colour = "white", linewidth = 1.4,
            height = 1, width = 1) +
  # "fit for duty" marker
  geom_richtext(data = fit_pos, aes(x = 4.58, y = y), label = "**Back on<br>duty**",
                hjust = 0, family = "poppins", size = 2.4, colour = sev_cols["0"],
                lineheight = 1, fill = NA, label.colour = NA,
                label.padding = unit(0, "pt"), inherit.aes = FALSE) +
  scale_fill_manual(values = sev_cols, guide = "none") +
  scale_x_continuous(breaks = 1:4, labels = levels(dt$symptom), position = "top",
                     expand = c(0, 0)) +
  scale_y_continuous(breaks = treat_pos$y, labels = treat_pos$label, expand = c(0, 0)) +
  coord_cartesian(xlim = c(0.5, 4.5), clip = "off") +
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = NULL) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 20)),
    plot.caption = element_text(size = 7, colour = faint, hjust = 0,
                                margin = margin(t = 18)),
    axis.text.x = element_text(size = 8.5, colour = ink, face = "bold",
                               margin = margin(b = 6)),
    axis.text.y = element_markdown(size = 9, colour = ink, hjust = 1,
                                   margin = margin(r = 8)),
    panel.grid  = element_blank(),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 60, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2023Week30_Scurvy.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2023Week30_Scurvy.svg", p, width = 7.5, height = 7.5, bg = "white")
