# US Government Grant Opportunities
# TidyTuesday 2023 · Week 40
# Question: which federal departments post the grants, and how has that changed?
#
# Note: the earlier version used `grant_opportunity_details`, which holds only
# 2,000 grants, mostly recent ones. That made 2023 look like a "grant explosion".
# The full `grants` table (74,669 grants) shows a steady total, so this version
# uses it instead and splits grants by department.

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(ggrepel)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
grants <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2023/2023-10-03/grants.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
# Department = first part of the agency code (HHS-NIH11 -> HHS)
dept_names <- c(HHS = "Health (HHS)", DOI = "Interior",
                DOS = "State", DOD = "Defense", USAID = "USAID", Other = "All other")

dt <- grants |>
  mutate(year = year(posted_date),
         dept = str_extract(agency_code, "^[A-Z]+")) |>
  filter(year >= 2008, year <= 2022) |>          # 2023 is incomplete (data ends in September)
  mutate(dept = if_else(dept %in% names(dept_names), dept, "Other"),
         # stacking order, top to bottom
         dept = factor(dept, levels = c("Other", "HHS", "DOD", "USAID", "DOS", "DOI"))) |>
  count(year, dept)

yearly <- dt |> group_by(year) |> summarise(n = sum(n))
doi    <- dt |> filter(dept == "DOI")
dos    <- dt |> filter(dept == "DOS")
doi_peak <- doi |> slice_max(n, n = 1)
doi_last <- doi |> filter(year == 2022)
dos_first <- dos |> filter(year == 2008); dos_last <- dos |> filter(year == 2022)

# Centred stream: stack the departments and shift each year down by half its total,
# then smooth every band edge with a spline so the shapes follow the real values.
bands <- dt |>
  complete(year, dept, fill = list(n = 0)) |>
  arrange(year, dept) |>
  group_by(year) |>
  mutate(ymax = sum(n) / 2 - lag(cumsum(n), default = 0),
         ymin = ymax - n) |>
  ungroup()

smooth_band <- function(d) {
  xs <- seq(min(d$year), max(d$year), length.out = 300)
  tibble(year = xs,
         ymin = spline(d$year, d$ymin, xout = xs, method = "natural")$y,
         ymax = spline(d$year, d$ymax, xout = xs, method = "natural")$y)
}
stream <- bands |> group_by(dept) |> group_modify(~ smooth_band(.x)) |> ungroup()

lab <- bands |> filter(year == 2022) |>
  mutate(y = (ymin + ymax) / 2,
         label = paste0(dept_names[as.character(dept)], "  ", scales::comma(n)))

# 4. COLOURS & TEXT --------------------------------------------------------
cols <- c(DOI = "#E07A3F", DOS = "#2A9D8F", HHS = "#9DB4C8", DOD = "#C3D0DB",
          USAID = "#D6DEE5", Other = "#E6EAEE")
lab_cols <- c(DOI = "#C4612A", DOS = "#1F7A6F", HHS = "#5A5A5A", DOD = "#5A5A5A",
              USAID = "#5A5A5A", Other = "#5A5A5A")
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("The Interior Department posts a sixth of the grants it did in ", doi_peak$year)

st <- paste0(
  "Federal grant opportunities posted on Grants.gov each year by department. ",
  "The total held at about 4,000–6,000 a year, but ",
  "<span style='color:", lab_cols["DOI"], "'>**Interior**</span> fell from ",
  scales::comma(doi_peak$n), " in ", doi_peak$year, " to ", doi_last$n,
  ", while the <span style='color:", lab_cols["DOS"], "'>**State Department**</span> ",
  "rose from ", dos_first$n, " to ", dos_last$n, ".")

ct <- paste0("Data source: Grants.gov, via the R4DS Online Learning Community",
             " · Creator: Zoi Diamantakou · TidyTuesday 2023 · Week 40")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot() +
  geom_vline(xintercept = seq(2008, 2022, 2), colour = "#EFEFEF", linewidth = 0.3) +
  geom_ribbon(data = stream, aes(year, ymin = ymin, ymax = ymax, fill = dept),
              colour = "white", linewidth = 0.3) +
  geom_text_repel(data = lab, aes(x = 2022, y = y, label = label, colour = dept,
                                  fontface = if_else(dept %in% c("DOI", "DOS"), "bold", "plain")),
                  family = "poppins", size = 2.5, hjust = 0, direction = "y",
                  nudge_x = 0.4, xlim = c(2022.3, NA), segment.size = 0.25,
                  segment.colour = "#B0B0B0", box.padding = 0.15, seed = 40) +
  annotate("text", x = 2022.4, y = yearly$n[yearly$year == 2022] / 2 + 250, label = "2022",
           hjust = 0, family = "poppins", fontface = "bold", size = 2.5, colour = muted) +
  scale_fill_manual(values = cols, guide = "none") +
  scale_colour_manual(values = lab_cols, guide = "none") +
  scale_x_continuous(breaks = seq(2008, 2022, 2), expand = c(0, 0)) +
  scale_y_continuous(breaks = NULL) +
  coord_cartesian(xlim = c(2008, 2025.6), clip = "off") +
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = NULL) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 20)),
    plot.caption = element_text(size = 7, colour = faint, hjust = 0,
                                margin = margin(t = 18)),
    axis.text.x = element_text(size = 7.5, colour = faint),
    panel.grid  = element_blank(),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2023Week40.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2023Week40.svg", p, width = 7.5, height = 7.5, bg = "white")
