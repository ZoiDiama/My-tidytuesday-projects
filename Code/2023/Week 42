# Taylor Swift
# TidyTuesday 2023 · Week 42
# Question: how does the sound of Taylor Swift's albums change?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
# A font with a music-note glyph for the markers (DejaVu Sans ships with most systems;
# on Windows/Mac "Segoe UI Symbol" or "Arial Unicode MS" also work)
font_add("notes", regular = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
taylor_album_songs <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2023/2023-10-17/taylor_album_songs.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
# Albums in the order they were first released
albums <- c("Taylor Swift", "Fearless (Taylor's Version)", "Speak Now",
            "Red (Taylor's Version)", "1989", "reputation", "Lover",
            "folklore", "evermore", "Midnights")
album_lab <- c("Taylor Swift", "Fearless (TV)", "Speak Now", "Red (TV)", "1989",
               "reputation", "Lover", "folklore", "evermore", "Midnights")
features <- c(acousticness = "Acousticness", energy = "Energy", valence = "Valence (positivity)",
              danceability = "Danceability", speechiness = "Speechiness", liveness = "Liveness")

dt <- taylor_album_songs |>
  select(album_name, all_of(names(features))) |>
  pivot_longer(-album_name, names_to = "feature", values_to = "value") |>
  group_by(album_name, feature) |>
  summarise(av = mean(value, na.rm = TRUE), .groups = "drop") |>
  mutate(album   = factor(album_name, levels = rev(albums), labels = rev(album_lab)),
         feature = factor(features[feature], levels = features),
         folk    = album_name %in% c("folklore", "evermore"))

ac        <- dt |> filter(feature == "Acousticness")
ac_folk   <- mean(ac$av[ac$folk])
ac_others <- mean(ac$av[!ac$folk])
ratio     <- ac_folk / ac_others

# 4. COLOURS & TEXT --------------------------------------------------------
purple <- "#513163"; pink <- "#A64477"; soft <- "#D8C3D1"
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("folklore and evermore are ", round(ratio, 1),
             " times as acoustic as Taylor Swift's other albums")

st <- paste0(
  "Average Spotify score (0 to 1) of the songs on Taylor Swift's 10 studio albums. ",
  "Each note is one album. <span style='color:", pink, "'>**folklore and evermore**</span> score ",
  round(ac$av[ac$album_name == "folklore"], 2), " and ", round(ac$av[ac$album_name == "evermore"], 2),
  " for acousticness; the other albums average ", round(ac_others, 2), ".")

ct <- paste0("Albums in order of first release. TV = Taylor's Version (2021 re-recordings).<br>",
             "Data source: taylor R package (W. Jake Thompson), Spotify · ",
             "Creator: Zoi Diamantakou · TidyTuesday 2023 · Week 42")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(av, album)) +
  geom_segment(aes(x = 0, xend = av, yend = album), colour = "#EFE6EC", linewidth = 0.4) +
  geom_text(aes(colour = folk), label = "♪", family = "notes", size = 4.6) +
  facet_wrap(~feature, ncol = 3) +
  scale_colour_manual(values = c(`TRUE` = pink, `FALSE` = soft), guide = "none") +
  scale_x_continuous(limits = c(0, 0.85), breaks = c(0, 0.4, 0.8), expand = c(0, 0.02)) +
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = NULL) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 14)),
    plot.caption = element_textbox_simple(size = 7, colour = faint,
                                          lineheight = 1.4, margin = margin(t = 16)),
    strip.text  = element_text(size = 9, colour = purple, face = "bold", hjust = 0),
    axis.text.y = element_text(size = 7.5, colour = ink),
    axis.text.x = element_text(size = 7, colour = faint),
    panel.grid  = element_blank(),
    panel.grid.major.x = element_line(colour = "#F1E9EE", linewidth = 0.3),
    panel.spacing.x = unit(14, "pt"),
    panel.spacing.y = unit(16, "pt"),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2023Week42.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2023Week42.svg", p, width = 7.5, height = 7.5, bg = "white")
