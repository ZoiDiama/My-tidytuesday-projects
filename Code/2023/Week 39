# Roy Kent's swear count (Ted Lasso)
# TidyTuesday 2023 · Week 39
# Question: did Roy Kent swear more over the seasons, and did ratings follow?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
richmondway <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2023/2023-09-26/richmondway.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
dt <- richmondway |>
  select(Season, Episode, F_count_RK, Imdb_rating)

by_season <- dt |> group_by(Season) |>
  summarise(per_ep = mean(F_count_RK), imdb = mean(Imdb_rating), total = sum(F_count_RK),
            .groups = "drop") |>
  mutate(strip = paste0("**Season ", Season, "**  ",
                        "<span style='color:#F2E9D8'>", round(per_ep, 1),
                        " per episode · IMDb ", sprintf("%.1f", imdb), "</span>"))

s1 <- by_season |> filter(Season == 1); s3 <- by_season |> filter(Season == 3)

dt <- dt |> left_join(by_season |> select(Season, strip), by = "Season") |>
  mutate(strip = factor(strip, levels = by_season$strip))

# Note in season 1 only, explaining how to read the chart
note <- tibble(strip = factor(by_season$strip[1], levels = by_season$strip),
               x = 6.1, y = 22, label = "Each label is the episode number.\nShaded: episodes rated 8 or below.")

# 4. COLOURS & TEXT --------------------------------------------------------
brown <- "#8C4F2B"; gold <- "#E0A84F"; shade <- "#F2762E"
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

top2 <- dt |> slice_max(F_count_RK, n = 2, with_ties = FALSE)

tt <- "Roy Kent's sweariest episodes were among Ted Lasso's best rated"

st <- paste0(
  "Roy Kent's F-words per episode against the episode's IMDb rating, by season. ",
  "His swearing doubled from ", round(s1$per_ep, 1), " to ", round(s3$per_ep, 1),
  " per episode, but episodes with more swearing didn't score lower. The two with the most (",
  top2$F_count_RK[1], " each) were rated ", sprintf("%.1f", top2$Imdb_rating[1]), " and ",
  sprintf("%.1f", top2$Imdb_rating[2]), ".")

ct <- paste0("Counts by Deepsha Menghani, from watching the show (spoken and gestured).<br>",
             "Data source: {richmondway} R package",
             " · Creator: Zoi Diamantakou · TidyTuesday 2023 · Week 39")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(Imdb_rating, F_count_RK)) +
  annotate("rect", xmin = 6, xmax = 8, ymin = 0, ymax = 25, alpha = 0.15, fill = shade) +
  geom_label(aes(label = Episode), fill = gold, colour = "white", family = "poppins",
             fontface = "bold", size = 2.6, label.size = 0,
             label.padding = unit(1.6, "pt")) +
  geom_text(data = note, aes(x, y, label = label), hjust = 0, vjust = 1,
            family = "poppins", size = 2.3, colour = "#B8622A", lineheight = 1) +
  facet_wrap(~ strip, ncol = 1) +
  scale_x_continuous(breaks = seq(6, 10, 0.5), limits = c(6, 10), expand = c(0, 0.05)) +
  scale_y_continuous(breaks = seq(0, 25, 5), limits = c(0, 25), expand = c(0, 0)) +
  labs(title = tt, subtitle = st, caption = ct,
       x = "IMDb rating", y = "Roy Kent's F-words") +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 16)),
    plot.caption = element_markdown(size = 7, colour = faint, hjust = 0,
                                    lineheight = 1.4, margin = margin(t = 16)),
    strip.text = element_markdown(size = 8.5, colour = "white", hjust = 0,
                                  margin = margin(4, 6, 4, 6)),
    strip.background = element_rect(fill = brown, colour = NA),
    panel.background = element_rect(fill = "#F7F0E3", colour = NA),
    panel.grid = element_blank(),
    panel.spacing.y = unit(4, "mm"),
    axis.title = element_text(size = 7.5, colour = faint),
    axis.text  = element_text(size = 7, colour = faint),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2023Week39.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2023Week39.svg", p, width = 7.5, height = 7.5, bg = "white")
