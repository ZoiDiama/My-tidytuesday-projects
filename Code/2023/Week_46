# Diwali Sales Data
# TidyTuesday 2023 · Week 46
# Question: what do people in India spend money on during Diwali, and where?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(ggalluvial)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
house <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2023/2023-11-14/diwali_sales_data.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
products <- c("Food", "Clothing & Apparel", "Electronics & Gadgets",
              "Footwear & Shoes", "Furniture", "Other")

dt <- house |>
  filter(!is.na(Amount)) |>
  mutate(Product = if_else(Product_Category %in% products, Product_Category, "Other")) |>
  group_by(Product, Zone) |>
  summarise(n = sum(Amount), .groups = "drop")

zone_tot <- dt |> group_by(Zone) |> summarise(tot = sum(n)) |> arrange(desc(tot))
prod_tot <- dt |> group_by(Product) |> summarise(tot = sum(n)) |>
  mutate(pct = tot / sum(tot) * 100)

dt <- dt |>
  mutate(Product = factor(Product, levels = products),
         Zone    = factor(Zone, levels = zone_tot$Zone))

food   <- prod_tot |> filter(Product == "Food")
cloth  <- prod_tot |> filter(Product == "Clothing & Apparel")
west   <- dt |> filter(Zone == "Western") |> mutate(p = n / sum(n) * 100) |> filter(Product == "Food")
north  <- dt |> filter(Zone == "Northern") |> mutate(p = n / sum(n) * 100) |>
  filter(Product == "Electronics & Gadgets")
total  <- sum(dt$n)

# Stratum labels: name + % for products (left), name + total for zones (right).
# ggalluvial stacks the first factor level at the top, so place labels at each block's middle.
lab_prod <- prod_tot |> mutate(Product = factor(Product, levels = products)) |> arrange(Product) |>
  mutate(y = sum(tot) - (cumsum(tot) - tot / 2),
         label = paste0("**", Product, "** ", round(pct), "%"))
lab_zone <- zone_tot |>
  mutate(y = sum(tot) - (cumsum(tot) - tot / 2),
         label = paste0("**", Zone, "** ₹", round(tot / 1e6, 1), "m"))

# 4. COLOURS & TEXT --------------------------------------------------------
cols <- c(Food = "#007095", `Clothing & Apparel` = "#2CBB9F", `Electronics & Gadgets` = "#023A4D",
          `Footwear & Shoes` = "#B11117", Furniture = "#F37021", Other = "#FDD2A7")
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("Food is ", round(food$pct), "% of Diwali spending, twice as much as clothing")

st <- paste0(
  "Spending by ", scales::comma(n_distinct(house$User_ID)), " shoppers in an Indian retail store ",
  "during Diwali (₹", round(total / 1e6), " million in total), by product and zone of India. ",
  "<span style='color:", cols["Food"], "'>**Food**</span> leads in every zone except the North, ",
  "where <span style='color:", cols["Electronics & Gadgets"], "'>**electronics**</span> take ",
  round(north$p), "%. In the West, food is ", round(west$p), "% of spending.")

ct <- paste0("Other = 13 smaller categories, such as games & toys, sports products and stationery.<br>",
             "Data source: Diwali Sales Data (Kaggle, Saad Haroon) · Creator: Zoi Diamantakou · ",
             "TidyTuesday 2023 · Week 46")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(axis1 = Product, axis2 = Zone, y = n)) +
  geom_flow(aes(fill = Product), width = 1/8, alpha = 0.75, curve_type = "cubic",
            colour = "white", linewidth = 0.2) +
  geom_stratum(aes(fill = Product), width = 1/8, colour = "white", linewidth = 0.6) +
  # product labels on the left, zone labels on the right
  geom_richtext(data = lab_prod, aes(x = 1 - 1/16 - 0.02, y = y, label = label),
                inherit.aes = FALSE, hjust = 1, family = "poppins", size = 2.8, colour = ink,
                fill = NA, label.colour = NA, label.padding = unit(0, "pt")) +
  geom_richtext(data = lab_zone, aes(x = 2 + 1/16 + 0.02, y = y, label = label),
                inherit.aes = FALSE, hjust = 0, family = "poppins", size = 2.8, colour = ink,
                fill = NA, label.colour = NA, label.padding = unit(0, "pt")) +
  scale_fill_manual(values = cols, guide = "none", na.value = "#A9A9A9") +
  scale_x_discrete(limits = c("Product", "Zone"), expand = c(0.32, 0.32), position = "top") +
  scale_y_continuous(expand = c(0, 0)) +
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = NULL) +
  theme_void(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 14)),
    plot.caption = element_textbox_simple(size = 7, colour = faint,
                                          lineheight = 1.4, margin = margin(t = 16)),
    axis.text.x = element_text(size = 9, colour = faint, face = "bold", margin = margin(b = 6)),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2023Week46.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2023Week46.svg", p, width = 7.5, height = 7.5, bg = "white")
