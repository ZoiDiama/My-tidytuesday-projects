# Hot Ones Episodes
# TidyTuesday 2023 · Week 32
# Question: how hot are the sauces in a Hot Ones lineup?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
sauces <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2023/2023-08-08/sauces.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
levels_heat <- c("Mild", "Mild hot", "Hot", "Spicy hot", "Very hot",
                 "Really hot", "Fiery hot", "Extreme hot")
ranges <- c("up to 2k", "2k–50k", "50k–100k", "100k–250k", "250k–500k",
            "500k–1M", "1M–1.5M", "over 1.5M")

dt <- sauces |>
  mutate(group = cut(scoville, c(0, 2000, 50000, 100000, 250000, 500000,
                                 1000000, 1500000, Inf), labels = levels_heat)) |>
  count(season, group)               # sauces per heat group, per season

n_seasons <- n_distinct(sauces$season)
finale    <- sauces |> filter(sauce_number == 10)
n_2m      <- sum(finale$scoville >= 2000000)
mild_mid  <- sauces |> filter(scoville <= 100000) |> nrow()

# 4. COLOURS & TEXT --------------------------------------------------------
cols <- setNames(rev(c("#d73027", "#fc8d59", "#fdae61", "#f6c75c",
                       "#d8c66a", "#a6cf6b", "#6fbf5c", "#1a9850")), levels_heat)
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("Every Hot Ones lineup climbs from mild to a 2-million-Scoville finale")

st <- paste0(
  "The 10 sauces in each of ", n_seasons, " seasons, grouped by Scoville heat. ",
  "Each circle is one season, placed at how many of its sauces fall in that group. ",
  n_2m, " of ", n_seasons, " seasons end on a 2-million-Scoville sauce.")

ct <- paste0("Scoville units measure chilli heat; a jalapeño is about 2,500–8,000.<br>",
             "Data source: Wikipedia, Hot Ones episode lists",
             " · Creator: Zoi Diamantakou · TidyTuesday 2023 · Week 32")

# 5. PLOT ------------------------------------------------------------------
set.seed(32)
p <- ggplot(dt, aes(group, n, colour = group)) +
  geom_vline(xintercept = seq(1.5, n_distinct(dt$group) - 0.5, 1),
             colour = "#EFEFEF", linewidth = 0.6) +
  geom_jitter(alpha = 0.6, size = 3.2, width = 0.32, height = 0.12) +
  scale_colour_manual(values = cols, guide = "none") +
  # named labels, so each label always matches its own group
  scale_x_discrete(labels = setNames(paste0("**", levels_heat, "**<br>",
                                            "<span style='color:#7A7A7A'>", ranges, "</span>"),
                                     levels_heat)) +
  scale_y_continuous(breaks = 0:5, limits = c(0.5, 5.3)) +
  labs(title = tt, subtitle = st, caption = ct,
       x = NULL, y = "Sauces per season") +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 20)),
    plot.caption = element_markdown(size = 7, colour = faint, hjust = 0,
                                    lineheight = 1.4, margin = margin(t = 18)),
    axis.title.y = element_text(size = 7.5, colour = faint, margin = margin(r = 8)),
    axis.text.x  = element_markdown(size = 7, colour = ink, lineheight = 1.2),
    axis.text.y  = element_text(size = 7.5, colour = faint),
    panel.grid   = element_blank(),
    panel.grid.major.y = element_line(colour = "#F3F3F3", linewidth = 0.3),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2023Week32_Hot.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2023Week32_Hot.svg", p, width = 7.5, height = 7.5, bg = "white")
