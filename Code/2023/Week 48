# Doctor Who Episodes
# TidyTuesday 2023 · Week 48
# Question: which seasons of the revived Doctor Who did audiences enjoy most?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
drwho_episodes <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2023/2023-11-28/drwho_episodes.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
# rating = BBC Audience Appreciation Index (0–100). Specials have no season
# number, so they are left out.
dt <- drwho_episodes |>
  filter(!is.na(season_number), !is.na(rating))

# Year = when episode 1 aired (Christmas specials can fall in the year before)
seasons <- dt |> group_by(season_number) |>
  summarise(avg = mean(rating),
            year = year(first_aired[which(episode_number == 1)[1]]),
            .groups = "drop")
best  <- seasons |> slice_max(avg, n = 1)
last  <- seasons |> slice_max(season_number, n = 1)
top   <- dt |> slice_max(rating, n = 1, with_ties = FALSE)
n_specials <- sum(is.na(drwho_episodes$season_number))

# 4. COLOURS & TEXT --------------------------------------------------------
mycol <- c("#a6b8c7", "#6f8ea9", "#003b6f", "#00203c")
ink <- "#10181C"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("Doctor Who peaked with series ", best$season_number, " in ", best$year,
             ", and scores have slipped since")

st <- paste0(
  "Audience Appreciation Index for every episode of the revived series, ",
  min(seasons$year), "–", max(seasons$year), ". The darker the tile, the more viewers ",
  "enjoyed it. Series ", best$season_number, " averaged ", round(best$avg, 1),
  "; series ", last$season_number, " averaged ", round(last$avg, 1), ".")

ct <- paste0("The Appreciation Index is the BBC's 0–100 audience score. ", n_specials,
             " specials without a series number are not shown.<br>",
             "Data source: Wikipedia, via {datardis} · Creator: Zoi Diamantakou · ",
             "TidyTuesday 2023 · Week 48")

# Season averages, shown under the grid
avg_lab <- seasons |> mutate(label = sprintf("%.0f", avg))

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(season_number, episode_number, fill = rating)) +
  geom_tile(colour = "white", linewidth = 0.6) +
  geom_text(aes(label = rating, colour = rating >= 85), family = "poppins",
            size = 2.4) +
  geom_text(data = avg_lab, aes(season_number, 14.2, label = label),
            inherit.aes = FALSE, family = "poppins", fontface = "bold",
            size = 2.6, colour = ink) +
  annotate("text", x = 0.4, y = 14.2, label = "Avg", hjust = 1, family = "poppins",
           fontface = "bold", size = 2.4, colour = faint) +
  scale_fill_gradientn(colours = mycol, limits = c(75, 91), breaks = c(75, 80, 85, 90),
                       name = "Appreciation Index") +
  scale_colour_manual(values = c(`TRUE` = "white", `FALSE` = ink), guide = "none") +
  scale_x_continuous(position = "top", breaks = 1:13,
                     labels = paste0(1:13, "\n", seasons$year), expand = c(0, 0)) +
  scale_y_reverse(breaks = 1:13, expand = c(0, 0)) +
  coord_cartesian(ylim = c(14.7, 0.5), clip = "off") +
  labs(title = tt, subtitle = st, caption = ct, x = "Series (first aired)", y = "Episode") +
  guides(fill = guide_colourbar(barwidth = unit(45, "mm"), barheight = unit(2.5, "mm"),
                                title.position = "left", title.vjust = 1)) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 10)),
    plot.caption = element_markdown(size = 7, colour = faint, hjust = 0,
                                    lineheight = 1.4, margin = margin(t = 16)),
    legend.position = "top",
    legend.justification = "left",
    legend.location = "plot",
    legend.title = element_text(size = 7.5, colour = muted, margin = margin(r = 8)),
    legend.text  = element_text(size = 7, colour = muted),
    legend.margin = margin(b = 8),
    axis.title   = element_text(size = 7.5, colour = faint, hjust = 0),
    axis.text.x  = element_text(size = 7, colour = ink, lineheight = 0.95),
    axis.text.y  = element_text(size = 7, colour = faint),
    panel.grid   = element_blank(),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2023Week48.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2023Week48.svg", p, width = 7.5, height = 7.5, bg = "white")
