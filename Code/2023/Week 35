# Fair Use
# TidyTuesday 2023 · Week 35
# Question: how often do US courts rule that a use was "fair"?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
fair_use_cases <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2023/2023-08-29/fair_use_cases.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
courts <- c("1st Circuit", "2nd Circuit", "3rd Circuit", "4th Circuit", "5th Circuit",
            "6th Circuit", "7th Circuit", "8th Circuit", "9th Circuit", "10th Circuit",
            "11th Circuit", "District of Columbia Circuit", "Federal Circuit",
            "U.S. Supreme Court")

# Folsom v. Marsh (1841) is the origin of the doctrine; the other cases start in 1950,
# so the axis starts in 1950 and the 1841 case is mentioned in the subtitle.
first_case <- fair_use_cases |> slice_min(year, n = 1)

dt <- fair_use_cases |>
  filter(year >= 1950) |>
  count(jurisdiction, year, fair_use_found) |>
  mutate(jurisdiction = factor(jurisdiction, levels = rev(courts)),
         result = if_else(fair_use_found, "Fair use", "Not fair use"))

# Totals per court for the right-hand column
totals <- fair_use_cases |>
  group_by(jurisdiction) |>
  summarise(n = n(), fair = mean(fair_use_found), .groups = "drop") |>
  mutate(jurisdiction = factor(jurisdiction, levels = rev(courts)),
         label = paste0("**", n, "**  <span style='color:#7A7A7A'>",
                        scales::percent(fair, accuracy = 1), " fair</span>"))

n_cases   <- nrow(fair_use_cases)
share_fair <- mean(fair_use_cases$fair_use_found)
share_top2 <- mean(fair_use_cases$jurisdiction %in% c("2nd Circuit", "9th Circuit"))

# 4. COLOURS & TEXT --------------------------------------------------------
teal <- "#2A9D8F"; orange <- "#E07A3F"
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- "US courts found fair use in only 2 of every 5 cases"

st <- paste0(
  n_cases, " court rulings on whether copying was ",
  "<span style='color:", teal, "'>**fair use**</span> or ",
  "<span style='color:", orange, "'>**not fair use**</span>, from the first case in ",
  first_case$year, " to 2022. ",
  "Two courts, New York's 2nd Circuit and California's 9th, decided ",
  scales::percent(share_top2, accuracy = 1), " of them.")

ct <- paste0("Data source: U.S. Copyright Office Fair Use Index",
             " · Creator: Zoi Diamantakou · TidyTuesday 2023 · Week 35")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(year, jurisdiction)) +
  geom_hline(yintercept = 1:length(courts), colour = "#EFEFEF", linewidth = 0.3) +
  geom_point(aes(size = n, colour = result), alpha = 0.7,
             position = position_nudge(y = if_else(dt$fair_use_found, 0.12, -0.12))) +
  # totals column on the right
  geom_richtext(data = totals, aes(x = 2026, y = jurisdiction, label = label),
                hjust = 0, family = "poppins", size = 2.4, colour = ink,
                fill = NA, label.colour = NA, label.padding = unit(0, "pt")) +
  annotate("text", x = 2026, y = length(courts) + 0.7, label = "Cases",
           hjust = 0, family = "poppins", fontface = "bold", size = 2.4, colour = muted) +
  scale_colour_manual(values = c(`Fair use` = teal, `Not fair use` = orange), guide = "none") +
  scale_size_area(max_size = 5, breaks = c(1, 2, 4), name = "Cases per year") +
  scale_x_continuous(breaks = seq(1950, 2020, 10)) +
  scale_y_discrete(labels = \(x) str_replace(x, "District of Columbia Circuit", "D.C. Circuit")) +
  coord_cartesian(xlim = c(1949, 2023), expand = FALSE, clip = "off") +
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = NULL) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 10)),
    plot.caption = element_text(size = 7, colour = faint, hjust = 0,
                                margin = margin(t = 18)),
    legend.position = "top",
    legend.justification = "left",
    legend.location = "plot",
    legend.title = element_text(size = 7.5, colour = muted),
    legend.text  = element_text(size = 7.5, colour = muted),
    legend.margin = margin(b = 6),
    axis.text.y  = element_text(size = 8, colour = ink, hjust = 1),
    axis.text.x  = element_text(size = 7.5, colour = faint),
    panel.grid   = element_blank(),
    panel.grid.major.x = element_line(colour = "#EFEFEF", linewidth = 0.3),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 95, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2023Week35.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2023Week35.svg", p, width = 7.5, height = 7.5, bg = "white")
