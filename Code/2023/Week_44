# Horror Legends
# TidyTuesday 2023 · Week 44
# Question: how many horror legends fact-checked by Snopes turned out to be true?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
horror_articles <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2023/2023-10-31/horror_articles.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
# Black = rated "true"; grey = every other rating (false, legend, mixture, unproven...)
dt <- horror_articles |>
  mutate(verdict = factor(if_else(rating == "true", "True", "Not true"),
                          levels = c("True", "Not true"))) |>
  count(author, verdict)

authors <- dt |> group_by(author) |>
  summarise(true = sum(n[verdict == "True"]), n = sum(n), .groups = "drop") |>
  arrange(desc(n)) |>
  mutate(strip = paste0("**", author, "**  <span style='color:#5A5A5A'>",
                        n, if_else(n == 1, " article", " articles"),
                        " · ", true, " true</span>"))

dt <- dt |> left_join(authors |> select(author, strip), by = "author") |>
  mutate(strip = factor(strip, levels = authors$strip)) |>
  arrange(strip, verdict)          # true squares first in each row

n_all  <- nrow(horror_articles)
n_true <- sum(horror_articles$rating == "true")
years  <- range(year(horror_articles$published))
barbara <- authors |> slice(1)

# 4. COLOURS & TEXT --------------------------------------------------------
yellow <- "#FDEE4E"; ink <- "#1A1A1A"; muted <- "#4A4A4A"

tt <- "Only 1 in 5 horror legends checked by Snopes turned out to be true"

st <- paste0(
  "Each square is one horror legend fact-checked on Snopes.com, ", years[1], "–", years[2],
  ", grouped by writer: <span style='color:#000000'>**true**</span> (", n_true, ") or ",
  "<span style='color:#8A8A8A'>**not true**</span> (", n_all - n_true, "). ",
  barbara$author, " wrote ", barbara$n, " of the ", n_all, " articles herself.")

ct <- paste0("\"Not true\" includes false, legend (folklore that can't be proven), mixture and unproven.<br>",
             "Data source: Snopes.com · Creator: Zoi Diamantakou · TidyTuesday 2023 · Week 44")

# 5. PLOT ------------------------------------------------------------------
# One block per writer: 2 rows of tiles, true first, filled column by column.
# Drawn by hand (not facets) so the tiles stay square and use the full width.
n_rows <- 2
gap    <- 4.3                      # vertical space per writer (tiles + name)
tiles <- dt |>
  uncount(n) |>
  group_by(strip) |>
  mutate(i = row_number() - 1,
         x = i %/% n_rows,
         y = -(as.integer(strip) - 1) * gap - (i %% n_rows)) |>
  ungroup()
names_df <- authors |>
  mutate(strip = factor(strip, levels = authors$strip),
         y = -(as.integer(strip) - 1) * gap + 1.35)

p <- ggplot(tiles, aes(x, y, fill = verdict)) +
  geom_tile(width = 0.82, height = 0.82, colour = NA) +
  geom_richtext(data = names_df, aes(x = -0.4, y = y, label = strip), inherit.aes = FALSE,
                hjust = 0, vjust = 0.5, family = "poppins", size = 2.7, colour = ink,
                fill = NA, label.colour = NA, label.padding = unit(0, "pt")) +
  scale_fill_manual(values = c(True = "black", `Not true` = "#A8A39A"), guide = "none") +
  coord_equal(xlim = c(-0.5, 73), ylim = c(-12 * 4.3 - 1.6, 2.2), expand = FALSE, clip = "off") +
  labs(title = tt, subtitle = st, caption = ct) +
  theme_void(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 10.5, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 22)),
    plot.caption = element_markdown(size = 7, colour = muted, hjust = 0,
                                    lineheight = 1.4, margin = margin(t = 16)),
    plot.background = element_rect(fill = yellow, colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2023Week44.png", p, width = 7.5, height = 7.5, dpi = 288, bg = yellow)
ggsave("TT2023Week44.svg", p, width = 7.5, height = 7.5, bg = yellow)
