# Haunted Places in the United States
# TidyTuesday 2023 · Week 41
# Question: which states have the most reported haunted places?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(geofacet)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
haunted_places <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2023/2023-10-10/haunted_places.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
dt <- haunted_places |>
  count(state = state_abbrev, name = "value") |>
  mutate(top = rank(-value) <= 5,
         label = if_else(top, paste0(state, "\n", scales::comma(value)), state))

top1  <- dt |> slice_max(value, n = 1)
top5  <- dt |> filter(top) |> arrange(desc(value))
total <- sum(dt$value)

# 4. COLOURS & TEXT --------------------------------------------------------
bg <- "#223343"; gold <- "#E9BC83"; light <- "#F4E3CC"

tt <- paste0("California has the most haunted places in the US: ",
             scales::comma(top1$value))

st <- paste0(
  scales::comma(total), " haunted places reported across the 50 states and DC. ",
  "The darker the tile, the more reports. The top five (",
  paste(top5$state, collapse = ", "), ") are large states, so the map partly ",
  "follows population.")

ct <- paste0("Data source: The Shadowlands Haunted Places Index, via Tim Renner",
             " · Creator: Zoi Diamantakou · TidyTuesday 2023 · Week 41")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt) +
  geom_rect(aes(xmin = 0, xmax = 1, ymin = 0, ymax = 1, fill = value)) +
  geom_text(aes(x = 0.5, y = 0.5, label = label,
                fontface = if_else(top, "bold", "plain")),
            colour = "white", family = "poppins", size = 2.6, lineheight = 0.95) +
  facet_geo(~ state, grid = "us_state_grid2") +
  scale_fill_gradient(low = "#CD7F4F", high = "#5A2A3A", name = "Haunted places",
                      labels = scales::comma,
                      guide = guide_colourbar(barwidth = unit(45, "mm"),
                                              barheight = unit(2.5, "mm"),
                                              title.position = "left", title.vjust = 1)) +
  coord_equal(expand = FALSE) +
  labs(title = tt, subtitle = st, caption = ct) +
  theme_void(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = gold,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = light,
                                           lineheight = 1.25, margin = margin(b = 10)),
    plot.caption = element_text(size = 7, colour = gold, hjust = 0,
                                margin = margin(t = 16)),
    legend.position = "top",
    legend.justification = "left",
    legend.location = "plot",
    legend.title = element_text(size = 7.5, colour = light, margin = margin(r = 8)),
    legend.text  = element_text(size = 7, colour = light),
    legend.margin = margin(b = 10),
    strip.text = element_blank(),
    panel.spacing = unit(1.2, "mm"),
    plot.background = element_rect(fill = bg, colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2023Week41.png", p, width = 7.5, height = 7.5, dpi = 288, bg = bg)
ggsave("TT2023Week41.svg", p, width = 7.5, height = 7.5, bg = bg)
