# US States
# TidyTuesday 2023 · Week 31
# Question: how crowded is each US state?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(maps)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
states <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2023/2023-08-01/states.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
bands <- c("Under 10", "10–25", "25–50", "50–100", "100–200", "200+")

dt <- states |>
  mutate(density = population_2020 / land_area_km2,
         band = cut(density, c(0, 10, 25, 50, 100, 200, Inf), labels = bands, right = FALSE),
         region = tolower(state))

map <- map_data("state") |> inner_join(dt, by = "region")

top    <- dt |> slice_max(density, n = 1)
bottom <- dt |> filter(region %in% unique(map$region)) |> slice_min(density, n = 1)
ratio  <- top$density / bottom$density
med    <- median(dt$density)
n_200  <- sum(dt$density >= 200)

# Label the 200+ states (small north-eastern states, so labels sit in the Atlantic)
lab <- dt |> filter(density >= 200) |>
  mutate(long = -66.5, lat = c(Massachusetts = 42.6, `Rhode Island` = 41.6, Connecticut = 40.6,
                               `New Jersey` = 39.6, Maryland = 38.6)[state],
         label = paste0(state, " ", round(density)))

# 4. COLOURS & TEXT --------------------------------------------------------
cols <- setNames(c("#FDE0DD", "#FCC5C0", "#FA9FB5", "#F768A1", "#AE017E", "#49006A"), bands)
bg <- "#FFFDF3"; ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0(top$state, " has ", round(top$density), " people per km², over ",
             floor(ratio / 100) * 100, " times ", bottom$state)

st <- paste0(
  "Population density of the US states in 2020 (people per km² of land). The typical state ",
  "has ", round(med), " people per km². The ", n_200, " states in ",
  "<span style='color:", cols["200+"], "'>**darkest purple**</span>, all on the north-east coast, ",
  "have more than 200.")

ct <- paste0("Alaska (0.5 per km², the least crowded state) and Hawaii are not shown on the map.<br>",
             "Data source: Wikipedia, 2020 US Census · Creator: Zoi Diamantakou · ",
             "TidyTuesday 2023 · Week 31")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(map, aes(long, lat, group = group, fill = band)) +
  geom_polygon(colour = "white", linewidth = 0.2) +
  geom_text(data = lab, aes(long, lat, label = label), inherit.aes = FALSE, hjust = 0,
            family = "poppins", size = 2.3, colour = cols["200+"]) +
  scale_fill_manual(values = cols, drop = FALSE, name = "People per km²") +
  coord_quickmap(xlim = c(-125, -60), clip = "off") +
  guides(fill = guide_legend(nrow = 1, title.position = "top", label.position = "bottom",
                             keywidth = unit(12, "mm"), keyheight = unit(2.5, "mm"))) +
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = NULL) +
  theme_void(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 10)),
    plot.caption = element_textbox_simple(size = 7, colour = faint,
                                          lineheight = 1.4, margin = margin(t = 16)),
    legend.position = "top",
    legend.justification = "left",
    legend.location = "plot",
    legend.title = element_text(size = 7.5, colour = muted),
    legend.text  = element_text(size = 7, colour = muted),
    legend.spacing.x = unit(0, "pt"),
    legend.margin = margin(b = 10),
    plot.background = element_rect(fill = bg, colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2023Week31.png", p, width = 7.5, height = 7.5, dpi = 288, bg = bg)
ggsave("TT2023Week31.svg", p, width = 7.5, height = 7.5, bg = bg)
