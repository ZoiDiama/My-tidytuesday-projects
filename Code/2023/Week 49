# Life Expectancy
# TidyTuesday 2023 · Week 49
# Question: how much longer do people live than in 1950, and where did the gains come from?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
life_expectancy <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2023/2023-12-05/life_expectancy.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
regions <- c("Oceania", "Europe", "Americas", "Asia", "Africa")

dt <- life_expectancy |>
  filter(Entity %in% c(regions, "World"), Year >= 1950) |>
  select(region = Entity, year = Year, le = LifeExpectancy)

first_year <- min(dt$year); last_year <- max(dt$year)

ends <- dt |>
  filter(year %in% c(first_year, last_year)) |>
  pivot_wider(names_from = year, values_from = le, names_prefix = "y") |>
  rename(start = 2, end = 3) |>
  mutate(gain = end - start)

asia  <- ends |> filter(region == "Asia")
world <- ends |> filter(region == "World")
gap_start <- ends$start[ends$region == "Europe"] - ends$start[ends$region == "Africa"]
gap_end   <- ends$end[ends$region == "Europe"]   - ends$end[ends$region == "Africa"]

# End labels: "Asia  72.5  (+30.5)"; small nudges so the five labels don't touch
lab <- ends |>
  mutate(y = end + case_when(region == "Oceania" ~ 1.2, region == "Europe" ~ -0.4,
                             region == "Americas" ~ -0.9, region == "Asia" ~ -1.3,
                             TRUE ~ 0),
         label = paste0("**", region, "** ", round(end, 1),
                        "  <span style='color:#7A7A7A'>+", round(gain), " yrs</span>"))

# 4. COLOURS & TEXT --------------------------------------------------------
cols <- c(Asia = "#D1495B", Africa = "#EDAE49", Americas = "#7A9CC6",
          Europe = "#2E4057", Oceania = "#66A182", World = "#9A9A9A")
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("People in Asia now live ", round(asia$gain),
             " years longer than in ", first_year)

st <- paste0(
  "Life expectancy at birth by continent, ", first_year, "–", last_year, ". ",
  "The world average rose from ", round(world$start), " to ", round(world$end), " years. ",
  "Africa gained ", round(ends$gain[ends$region == "Africa"]), " years but still trails ",
  "Europe by ", round(gap_end), " years, down from ", round(gap_start), ".")

ct <- paste0("Data source: Our World in Data",
             " · Creator: Zoi Diamantakou · TidyTuesday 2023 · Week 49")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(filter(dt, region != "World"), aes(year, le, colour = region)) +
  # COVID dip
  annotate("rect", xmin = 2019.5, xmax = last_year, ymin = 30, ymax = 85,
           fill = "#F3F3F3") +
  annotate("text", x = 2019.2, y = 33, label = "COVID-19", hjust = 1,
           family = "poppins", size = 2.3, colour = faint) +
  geom_line(data = filter(dt, region == "World"), linetype = "22",
            linewidth = 0.5, colour = cols["World"]) +
  annotate("text", x = 1951, y = 54.2, label = "World average", hjust = 0,
           hjust = 0, family = "poppins", size = 2.4, colour = faint) +
  geom_line(linewidth = 1.1) +
  annotate("segment", x = 1961.4, xend = 1960.3, y = 37.6, yend = 41.2,
           colour = cols["Asia"], linewidth = 0.3) +
  annotate("text", x = 1961.6, y = 36.4, label = "China's famine,\n1959–61", hjust = 0,
           family = "poppins", size = 2.3, colour = cols["Asia"], lineheight = 0.95) +
  geom_point(data = filter(dt, region != "World", year %in% c(first_year, last_year)),
             size = 1.8) +
  geom_richtext(data = filter(lab, region != "World"),
                aes(x = last_year + 1.5, y = y, label = label),
                hjust = 0, family = "poppins", size = 2.6, fill = NA,
                label.colour = NA, label.padding = unit(0, "pt")) +
  scale_colour_manual(values = cols, guide = "none") +
  scale_x_continuous(breaks = seq(1950, 2020, 10), expand = c(0, 0)) +
  scale_y_continuous(limits = c(30, 85), breaks = seq(30, 80, 10),
                     labels = \(x) paste0(x, " yrs"), expand = c(0, 0)) +
  coord_cartesian(xlim = c(first_year, last_year), clip = "off") +
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = NULL) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 20)),
    plot.caption = element_text(size = 7, colour = faint, hjust = 0,
                                margin = margin(t = 18)),
    axis.text  = element_text(size = 7.5, colour = faint),
    panel.grid = element_blank(),
    panel.grid.major.y = element_line(colour = "#ECECEC", linewidth = 0.3),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 140, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2023Week49.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2023Week49.svg", p, width = 7.5, height = 7.5, bg = "white")
