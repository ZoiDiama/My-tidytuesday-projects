# The Global Human Day
# TidyTuesday 2023 · Week 37
# Question: how does time spent caring for our bodies differ between world regions?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(treemapify)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
base <- "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2023/2023-09-12/"
all_countries   <- read_csv(paste0(base, "all_countries.csv"), show_col_types = FALSE)
country_regions <- read_csv(paste0(base, "country_regions.csv"), show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
# "Somatic maintenance" = sleep, hygiene, health care and physical child care.
# Simple average of the countries in each region, in hours per day.
dt <- all_countries |>
  left_join(country_regions, by = c("country_iso3", "region_code")) |>
  filter(Category == "Somatic maintenance", !is.na(region_name)) |>
  group_by(region_name, Subcategory) |>
  summarise(hours = mean(hoursPerDayCombined), .groups = "drop")

# Order the regions by time spent on health care, most first
health <- dt |> filter(Subcategory == "Health care") |>
  arrange(desc(hours)) |>
  mutate(minutes = round(hours * 60))
dt <- dt |> mutate(region_name = factor(region_name, levels = health$region_name))

top <- health |> slice_head(n = 1)
bottom <- health |> slice_tail(n = 1)

# Box positions for each region's treemap (one treemap per facet)
acts <- c("Sleep & bedrest", "Hygiene & grooming", "Physical child care", "Health care")
boxes <- dt |>
  mutate(Subcategory = factor(Subcategory, levels = acts)) |>
  group_by(region_name) |>
  arrange(Subcategory, .by_group = TRUE) |>
  group_modify(~ treemapify(as.data.frame(mutate(.x, Subcategory = as.character(Subcategory))),
                            area = "hours", layout = "fixed",
                            xlim = c(0, 1), ylim = c(0, 1)) |> as_tibble()) |>
  ungroup()

# Label for the health-care box: minutes per day
hc_lab <- boxes |>
  filter(Subcategory == "Health care") |>
  mutate(label = paste0(round(hours * 60), " min"))

sleep_lab <- boxes |>
  filter(Subcategory == "Sleep & bedrest") |>
  mutate(label = paste0("Sleep ", round(hours, 1), " h"))

# Facet titles: region name + minutes
strip_lab <- setNames(paste0(health$region_name), health$region_name)

# 4. COLOURS & TEXT --------------------------------------------------------
red <- "#C0392B"
cols <- c(`Sleep & bedrest` = "#E7E9EC", `Hygiene & grooming` = "#D2D6DB",
          `Physical child care` = "#BDC3CA", `Health care` = red)
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("The ", top$region_name, " spends ", round(top$hours / bottom$hours),
             " times longer on health care than ", bottom$region_name)

st <- paste0(
  "Daily time spent caring for the body, by world region. Each square splits it into ",
  "sleep (large box), hygiene (top strip), child care and <span style='color:", red,
  "'>**health care**</span>, minutes per day.")

ct <- paste0("Data source: The Human Chronome Project (Fajzel et al., 2023)",
             " · Creator: Zoi Diamantakou · TidyTuesday 2023 · Week 37")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(boxes) +
  geom_rect(aes(xmin = xmin, xmax = xmax, ymin = ymin, ymax = ymax, fill = Subcategory),
            colour = "white", linewidth = 0.5) +
  geom_text(data = hc_lab, aes(x = xmax + 0.03, y = (ymin + ymax) / 2, label = label),
            hjust = 0, family = "poppins", fontface = "bold", size = 2.3, colour = red) +
  geom_text(data = sleep_lab, aes(x = xmin + 0.05, y = ymin + 0.12, label = label),
            hjust = 0, family = "poppins", size = 2, colour = "#9A9A9A") +
  facet_wrap(~ region_name, ncol = 4, labeller = as_labeller(strip_lab)) +
  scale_fill_manual(values = cols, guide = "none") +
  scale_x_continuous(expand = c(0, 0)) +
  scale_y_continuous(expand = c(0, 0)) +
  coord_cartesian(clip = "off") +
  labs(title = tt, subtitle = st, caption = ct) +
  theme_void(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 20, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 10.5, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 16)),
    plot.caption = element_text(size = 7, colour = faint, hjust = 0,
                                margin = margin(t = 16)),
    strip.text = element_text(size = 6.8, colour = ink, hjust = 0,
                              margin = margin(b = 3)),
    panel.spacing.x = unit(10, "mm"),
    panel.spacing.y = unit(3.5, "mm"),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 50, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2023Week37.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2023Week37.svg", p, width = 7.5, height = 7.5, bg = "white")
