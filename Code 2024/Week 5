# Groundhog predictions
# TidyTuesday 2024 · Week 5
# Question: do the groundhogs agree on whether spring comes early?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(waffle)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
predictions <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-01-30/predictions.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
# shadow = TRUE  -> six more weeks of winter
# shadow = FALSE -> early spring
dt <- predictions |>
  filter(year >= 2000, !is.na(shadow)) |>
  mutate(forecast = factor(if_else(shadow, "Longer winter", "Early spring"),
                           levels = c("Early spring", "Longer winter"))) |>
  count(year, forecast)

yearly <- dt |>
  pivot_wider(names_from = forecast, values_from = n, values_fill = 0) |>
  mutate(total = `Early spring` + `Longer winter`,
         label = paste0(year, "  <span style='color:#7A7A7A'>", total, "</span>"))

first <- yearly |> slice_min(year, n = 1)
last  <- yearly |> slice_max(year, n = 1)
n_spring_wins <- sum(yearly$`Early spring` > yearly$`Longer winter`)

# Punxsutawney Phil, the original groundhog (id 1)
phil <- predictions |> filter(id == 1, year >= 2000, !is.na(shadow))
phil_winter <- sum(phil$shadow)

dt <- dt |> left_join(yearly |> select(year, label), by = "year") |>
  mutate(label = factor(label, levels = yearly$label))

# 4. COLOURS & TEXT --------------------------------------------------------
spring <- "#7FB77E"; winter <- "#6C8EBF"
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- "Four times as many groundhogs now forecast the weather as in 2000"

st <- paste0(
  "Groundhog Day forecasts, ", first$year, "–", last$year, ". Each square is one forecaster ",
  "(grey number: how many that year), calling ",
  "<span style='color:", spring, "'>**an early spring**</span> or ",
  "<span style='color:", winter, "'>**a longer winter**</span>. ",
  "They rarely agree: spring won the vote in ", n_spring_wins, " of ", nrow(yearly), " years.")

ct <- paste0("Punxsutawney Phil, the most famous groundhog, predicted a longer winter in ",
             phil_winter, " of ", nrow(phil), " years.<br>",
             "Data source: groundhog-day.com",
             " · Creator: Zoi Diamantakou · TidyTuesday 2024 · Week 5")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(fill = forecast, values = n)) +
  geom_waffle(colour = "white", size = 0.3, n_rows = 10, flip = TRUE, na.rm = TRUE) +
  facet_wrap(~ label, ncol = 6, strip.position = "bottom") +
  scale_fill_manual(values = c(`Early spring` = spring, `Longer winter` = winter),
                    guide = "none") +
  scale_x_discrete() +
  scale_y_continuous(expand = c(0, 0)) +
  coord_equal() +
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = NULL) +
  theme_void(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 20)),
    plot.caption = element_markdown(size = 7, colour = faint, hjust = 0,
                                    lineheight = 1.4, margin = margin(t = 18)),
    strip.text = element_markdown(size = 7.5, colour = ink, margin = margin(t = 3, b = 6)),
    panel.spacing.x = unit(4, "mm"),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week5.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2024Week5.svg", p, width = 7.5, height = 7.5, bg = "white")
