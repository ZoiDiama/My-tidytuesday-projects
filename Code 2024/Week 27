# TidyTuesday Datasets
# TidyTuesday 2024 · Week 27
# Question: how big are TidyTuesday datasets, and has that changed?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
tt_datasets <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-07-02/tt_datasets.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
# Many weeks have several datasets; with one tile per week they would be drawn on top
# of each other. So each tile shows the week's total number of rows.
sizes <- c("Under 1,000", "1,000–10,000", "10,000–1 million", "Over 1 million")

dt <- tt_datasets |>
  group_by(year, week) |>
  summarise(rows = sum(observations), n = n(), .groups = "drop") |>
  mutate(size = cut(rows, c(0, 1000, 10000, 1e6, Inf), labels = sizes, right = TRUE))

n_weeks <- nrow(dt)
n_big   <- sum(dt$size == "Over 1 million")
med     <- median(dt$rows)
n_multi <- sum(dt$n > 1)
biggest <- tt_datasets |> slice_max(observations, n = 1)

# 4. COLOURS & TEXT --------------------------------------------------------
cols <- setNames(viridisLite::viridis(4, direction = -1), sizes)
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("Only ", n_big, " of ", n_weeks, " TidyTuesday weeks came with more than a million rows of data")

st <- paste0(
  "Total rows in the datasets released each TidyTuesday week, 2018–2024. Each square is one week; ",
  "blank squares are weeks without new data. The typical week has about ",
  scales::comma(round(med, -2)), " rows. The biggest dataset, ", biggest$dataset_name, " (",
  biggest$year, "), has ", round(biggest$observations / 1e6, 1), " million.")

ct <- paste0(n_multi, " weeks released more than one dataset; their rows are added together. ",
             "2024 runs to week 27.<br>",
             "Data source: ttmeta R package · Creator: Zoi Diamantakou · TidyTuesday 2024 · Week 27")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(factor(week, levels = 1:52), factor(year, levels = 2024:2018), fill = size)) +
  geom_tile(colour = "white", linewidth = 0.6) +
  scale_fill_manual(values = cols, name = "Rows per week", drop = FALSE) +
  scale_x_discrete(breaks = c(1, seq(5, 50, 5)), drop = FALSE) +
  coord_equal() +
  guides(fill = guide_legend(nrow = 1, title.position = "left",
                             keywidth = unit(3, "mm"), keyheight = unit(3, "mm"))) +
  labs(title = tt, subtitle = st, caption = ct, x = "Week of the year", y = NULL) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 12)),
    plot.caption = element_textbox_simple(size = 7, colour = faint,
                                          lineheight = 1.4, margin = margin(t = 16)),
    legend.position = "top",
    legend.justification = "left",
    legend.location = "plot",
    legend.title = element_text(size = 7.5, colour = muted),
    legend.text  = element_text(size = 7.5, colour = muted),
    legend.margin = margin(b = 6),
    axis.title.x = element_text(size = 7.5, colour = faint, hjust = 0, margin = margin(t = 6)),
    axis.text.x  = element_text(size = 7, colour = faint),
    axis.text.y  = element_text(size = 8, colour = ink, face = "bold"),
    panel.grid = element_blank(),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
# Landscape: 52 weeks across need the width
ggsave("TT2024Week27.png", p, width = 10, height = 4.9, dpi = 288, bg = "white")
ggsave("TT2024Week27.svg", p, width = 10, height = 4.9, bg = "white")
