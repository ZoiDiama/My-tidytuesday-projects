# Economic Diversity and Student Outcomes
# TidyTuesday 2024 · Week 37
# Question: among students who apply, does parents' income change who ends up attending?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
college_admissions <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-09-10/college_admissions.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
# rel_att_cond_app: attendance rate among applicants from this income group,
# relative to the college's average applicant (1 = same as average).
income_order <- c("0-20", "20-40", "40-60", "60-70", "70-80", "80-90",
                  "90-95", "95-96", "96-97", "97-98", "98-99", "99-99.9",
                  "Top 1", "Top 0.1")

focus <- c("Ivy Plus", "Highly selective public")

dt <- college_admissions |>
  group_by(tier, par_income_lab) |>
  summarise(av_att = mean(rel_att_cond_app, na.rm = TRUE), .groups = "drop") |>
  mutate(par_income_lab = factor(par_income_lab, levels = income_order),
         highlight = if_else(tier %in% focus, tier, "Other"))

n_ivy  <- n_distinct(college_admissions$name[college_admissions$tier == "Ivy Plus"])
ivy_top <- dt |> filter(tier == "Ivy Plus", par_income_lab == "Top 0.1") |> pull(av_att)
pub_top <- dt |> filter(tier == "Highly selective public", par_income_lab == "Top 0.1") |> pull(av_att)

# Nicer income labels: "Bottom 20%", "Top 1%", ...
lab_income <- c("0-20" = "Bottom 20%", "20-40" = "20–40th", "40-60" = "40–60th",
                "60-70" = "60–70th", "70-80" = "70–80th", "80-90" = "80–90th",
                "90-95" = "90–95th", "95-96" = "95–96th", "96-97" = "96–97th",
                "97-98" = "97–98th", "98-99" = "98–99th", "99-99.9" = "99–99.9th",
                "Top 1" = "Top 1%", "Top 0.1" = "Top 0.1%")

# 4. COLOURS & TEXT --------------------------------------------------------
navy <- "#003366"; red <- "#9B1B30"; grey <- "#C9C9C9"
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"
cols <- c("Ivy Plus" = navy, "Highly selective public" = red, "Other" = grey)

tt <- "At Ivy-Plus colleges, the richest 0.1% of applicants are twice as likely to attend"

st <- paste0(
  "Chance of attending after applying, by parents' income, versus the average applicant (1×). ",
  "The ", n_ivy, " <span style='color:", navy, "'>**Ivy-Plus**</span> colleges favour the richest; ",
  "<span style='color:", red, "'>**highly selective publics**</span> do the reverse. ",
  "Grey: other selective colleges.")

ct <- paste0("Data source: Opportunity Insights (Chetty, Deming & Friedman)",
             " · Creator: Zoi Diamantakou · TidyTuesday 2024 · Week 37")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(x = av_att, y = par_income_lab)) +
  # "average applicant" reference line
  geom_vline(xintercept = 1, colour = "#9A9A9A", linewidth = 0.4) +
  annotate("text", x = 1.01, y = 14.75, label = "Average applicant",
           family = "poppins", size = 2.3, colour = faint, hjust = 0) +
  # light row guides
  geom_hline(yintercept = 1:14, colour = "#EFEFEF", linewidth = 0.3) +
  # other tiers in the background, focus tiers on top
  geom_point(data = filter(dt, highlight == "Other"), colour = grey, size = 2) +
  geom_point(data = filter(dt, highlight != "Other"),
             aes(colour = highlight), size = 3) +
  # direct labels on the top row
  annotate("text", x = ivy_top, y = 14, label = paste0(round(ivy_top, 1), "×"),
           family = "poppins", fontface = "bold", colour = navy, size = 3,
           vjust = -1.1) +
  annotate("text", x = pub_top, y = 14, label = paste0(round(pub_top, 1), "×"),
           family = "poppins", fontface = "bold", colour = red, size = 3,
           vjust = -1.1) +
  # where the middle class sits
  annotate("text", x = 0.62, y = 5, label = "Middle class:\nbelow average\nat Ivy-Plus",
           family = "poppins", size = 2.3, colour = navy, hjust = 0, lineheight = 0.95) +
  scale_colour_manual(values = cols, guide = "none") +
  scale_y_discrete(labels = lab_income) +
  scale_x_continuous(limits = c(0.6, 2.15), breaks = c(0.75, 1, 1.25, 1.5, 1.75, 2),
                     labels = \(x) paste0(x, "×"), expand = c(0, 0)) +
  coord_cartesian(clip = "off") +
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = NULL) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 26)),
    plot.caption = element_text(size = 7, colour = faint, hjust = 0,
                                margin = margin(t = 18)),
    axis.text    = element_text(size = 7.5, colour = faint),
    panel.grid   = element_blank(),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week_37.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2024Week_37.svg", p, width = 7.5, height = 7.5, bg = "white")
