# World's Fairs
# TidyTuesday 2024 · Week 33
# Question: which world's fairs drew the biggest crowds?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(ggrepel)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
worlds_fairs <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-08-13/worlds_fairs.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
dt <- worlds_fairs |>
  filter(!is.na(visitors)) |>
  mutate(category = factor(category, levels = c("World Expo", "Specialised Expo")),
         y = if_else(category == "World Expo", 2, 1)) |>
  arrange(desc(visitors))

top <- dt |> slice_max(visitors, n = 5) |>
  mutate(label = paste0(name_of_exposition, ", ", city, "\n", round(visitors), " million"))
biggest <- top |> slice(1)
n_missing <- sum(is.na(worlds_fairs$visitors))
med <- dt |> group_by(category) |> summarise(m = median(visitors))

# 4. COLOURS & TEXT --------------------------------------------------------
cols <- c(`World Expo` = "#2A9D8F", `Specialised Expo` = "#264653")
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("Shanghai's Expo ", biggest$start_year, " drew ", round(biggest$visitors),
             " million visitors, more than any other world's fair")

st <- paste0(
  "Visitors to <span style='color:", cols[1], "'>**World Expos**</span> and smaller ",
  "<span style='color:", cols[2], "'>**Specialised Expos**</span>, 1851–2021. ",
  "Circles are sized by visitors. A typical World Expo drew ",
  round(med$m[med$category == "World Expo"]), " million, a Specialised Expo ",
  round(med$m[med$category == "Specialised Expo"]), " million.")

ct <- paste0(n_missing, " fairs with no visitor figure are not shown.<br>",
             "Data source: Wikipedia · Creator: Zoi Diamantakou · TidyTuesday 2024 · Week 33")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(start_year, y)) +
  geom_hline(yintercept = c(1, 2), colour = "#E2E2E2", linewidth = 0.4) +
  geom_point(aes(size = visitors, fill = category), shape = 21, colour = "white",
             stroke = 0.4, alpha = 0.85) +
  geom_text_repel(data = top, aes(label = label), family = "poppins", size = 2.4,
                  colour = ink, lineheight = 0.95, nudge_y = 0.55, direction = "x",
                  segment.colour = "#9A9A9A", segment.size = 0.25, min.segment.length = 0,
                  seed = 33) +
  annotate("text", x = 1850, y = c(2.18, 1.18), label = c("World Expos", "Specialised Expos"),
           hjust = 0, vjust = 0, family = "poppins", fontface = "bold", size = 3,
           colour = cols) +
  scale_fill_manual(values = cols, guide = "none") +
  scale_size_area(max_size = 18, breaks = c(10, 30, 60),
                  labels = c("10 million", "30 million", "60 million visitors"), name = NULL) +
  scale_x_continuous(breaks = seq(1850, 2020, 25)) +
  scale_y_continuous(limits = c(0.5, 2.9), breaks = NULL) +
  coord_cartesian(clip = "off") +
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = NULL) +
  guides(size = guide_legend(override.aes = list(fill = "#BDBDBD"))) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 10)),
    plot.caption = element_markdown(size = 7, colour = faint, hjust = 0,
                                    lineheight = 1.4, margin = margin(t = 16)),
    legend.position = "top",
    legend.justification = "left",
    legend.location = "plot",
    legend.text = element_text(size = 7, colour = muted),
    axis.text.x = element_text(size = 7.5, colour = faint),
    panel.grid = element_blank(),
    panel.grid.major.x = element_line(colour = "#F0F0F0", linewidth = 0.3),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week_33.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2024Week_33.svg", p, width = 7.5, height = 7.5, bg = "white")
