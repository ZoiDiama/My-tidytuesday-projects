# Fiscal Sponsors
# TidyTuesday 2024 · Week 11
# Question: how many projects does a typical fiscal sponsor support?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(treemapify)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
fiscal_sponsor_directory <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-03-12/fiscal_sponsor_directory.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
sponsors <- fiscal_sponsor_directory |>
  filter(!is.na(n_sponsored), n_sponsored > 0)

groups <- c("1–5 projects", "6–10 projects", "11–25 projects",
            "26–100 projects", "101+ projects")

dt <- sponsors |>
  mutate(group = cut(n_sponsored, c(0, 5, 10, 25, 100, Inf), labels = groups)) |>
  group_by(group) |>
  summarise(n = n(), projects = sum(n_sponsored), .groups = "drop") |>
  mutate(pct  = n / sum(n),
         label = paste0("<span style='font-size:22pt'>**",
                        scales::percent(pct, accuracy = 1), "**</span><br>",
                        group, "<br><span style='font-size:7pt'>",
                        n, " sponsors</span>"))

n_sponsors <- nrow(sponsors)
big        <- dt |> filter(group == "101+ projects")
big_share  <- big$projects / sum(dt$projects)

# 4. COLOURS & TEXT --------------------------------------------------------
# One colour scale, light (small sponsors) to dark (large sponsors)
cols <- setNames(c("#CFE3F1", "#9CC5E3", "#5E9DCB", "#2F6FA6", "#123F6B"), groups)
text_col <- setNames(c("#1A1A1A", "#1A1A1A", "white", "white", "white"), groups)
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- "One in three fiscal sponsors supports five projects or fewer"

st <- paste0(
  n_sponsors, " US fiscal sponsors, grouped by how many projects they support (May 2024). ",
  "Each box is sized by the number of sponsors. At the other end, just ", big$n,
  " large sponsors run ", scales::percent(big_share, accuracy = 1),
  " of all ", scales::comma(sum(dt$projects)), " sponsored projects.")

ct <- paste0("Data source: Fiscal Sponsor Directory",
             " · Creator: Zoi Diamantakou · TidyTuesday 2024 · Week 11")

# 5. PLOT ------------------------------------------------------------------
# Box positions from treemapify, so the labels can use rich text
boxes <- treemapify(dt, area = "n", layout = "squarified",
                    xlim = c(0, 1), ylim = c(0, 1))

p <- ggplot(boxes) +
  geom_rect(aes(xmin = xmin, xmax = xmax, ymin = ymin, ymax = ymax, fill = group),
            colour = "white", linewidth = 1.5) +
  geom_richtext(aes(x = xmin + 0.025, y = ymax - 0.025, label = label, colour = group),
                hjust = 0, vjust = 1, family = "poppins", size = 3.2, lineheight = 1.15,
                fill = NA, label.colour = NA, label.padding = unit(0, "pt")) +
  scale_fill_manual(values = cols, guide = "none") +
  scale_colour_manual(values = text_col, guide = "none") +
  scale_x_continuous(expand = c(0, 0)) +
  scale_y_continuous(expand = c(0, 0)) +
  labs(title = tt, subtitle = st, caption = ct) +
  theme_void(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 20)),
    plot.caption = element_text(size = 7, colour = faint, hjust = 0,
                                margin = margin(t = 18)),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week11.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2024Week11.svg", p, width = 7.5, height = 7.5, bg = "white")
