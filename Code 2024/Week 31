#Summer movies
#2024: week 31


#load basic libraries
library(tidyverse) # Collection of tools for data manipulation and visualization.
library(showtext) #Easily use custom fonts in plots.Allows the use of google fonts
library(ggtext) #Allows rich text formatting (Markdown/HTML) in ggplot.
library(waffle)


## Load Google fonts (https://fonts.google.com/)
font_add_google("Poppins", family = "poppins")
showtext::showtext_auto()
showtext::showtext_opts(dpi = 300)

#1.DATA LOADING
base <- "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-07-30/"
summer_movie_genres <- read_csv(paste0(base, "summer_movie_genres.csv"), show_col_types = FALSE)
summer_movies       <- read_csv(paste0(base, "summer_movies.csv"), show_col_types = FALSE)

#2.DATA WRANGLING
dt<-summer_movie_genres %>%
  filter(!is.na(genres)) %>%
  mutate(col=case_when(
    genres=="Drama"~"Drama",
    genres=="Comedy"~"Comedy",
    genres=="Romance"~"Romance",
    TRUE~"Other")) %>%
  mutate(col=factor(col,
                    levels=c("Drama","Comedy","Romance","Other"))) %>%
  arrange(col) %>%   # order the tiles: all Drama first, then Comedy, Romance, Other
  mutate(n=1)

# numbers for the subtitle and note
n_films  <- n_distinct(summer_movies$tconst)
n_genres <- n_distinct(summer_movie_genres$genres, na.rm = TRUE)
years    <- range(summer_movies$year, na.rm = TRUE)
counts   <- dt %>% count(col)
get_n    <- function(g) counts$n[counts$col == g]

#3. PLOT VIZUALIZATION
##colours & text
cols <- c(Drama = "#061057", Comedy = "#F15B28", Romance = "#8A1309", Other = "#D3D6CB")
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- "Drama is the most common genre in 'summer' films"

st <- paste0(
  n_films, " films with \"summer\" in the title, ", years[1], "–", years[2], ", across ",
  n_genres, " genres. Each square is one genre tag: ",
  "<span style='color:", cols["Drama"], "'>**drama**</span>, ",
  "<span style='color:", cols["Comedy"], "'>**comedy**</span>, ",
  "<span style='color:", cols["Romance"], "'>**romance**</span> or another genre. ",
  "More than half of the films are dramas.")

# Labels above each genre block (10 rows, filled column by column)
labs_df <- counts %>%
  mutate(end = cumsum(n) / 10, start = lag(end, default = 0),
         x = (start + end) / 2 + 0.5,
         label = paste0("**", if_else(col == "Other", "Other genres", as.character(col)),
                        "** ", n))

ct <- paste0("Note: one film can have more than one genre, so there are ",
             scales::comma(nrow(dt)), " squares for ", n_films, " films.<br>",
             "Data source: IMDb · Creator: Zoi Diamantakou · TidyTuesday 2024 · Week 31")

##plot (unchanged from the original)
p<-
  ggplot(dt,aes(fill = col, values = n)) +
  geom_waffle(colour = 'white',
              tile_shape = 'circle',
              n_rows = 10,
              size=0.25,
              radius = unit(0.7, units = "mm"),
              na.rm = TRUE,
              flip = FALSE)+
  geom_richtext(data = labs_df, aes(x = x, y = 10.8, label = label, colour = col),
                inherit.aes = FALSE, vjust = 0, family = "poppins", size = 4.5,
                fill = NA, label.colour = NA, label.padding = unit(0, "pt")) +
  scale_fill_manual(values = cols, guide = "none") +
  scale_colour_manual(values = c(cols[1:3], Other = "#8A8A8A"), guide = "none") +
  coord_cartesian(clip = "off") +
  scale_x_discrete(expand=c(0,0)) +
  scale_y_discrete(expand=c(0,0))+
  labs(title=tt,
       subtitle = st,
       caption = ct,
       x=NULL,
       y=NULL)

##theme: featured-chart title block (text wraps, so nothing is cut off)
p<- p+theme_minimal(base_family = "poppins")+
  theme(plot.margin= margin(t = 50, r = 50, b = 50, l = 50),
        plot.title.position   = "plot",
        plot.caption.position = "plot",
        plot.title = element_textbox_simple(face = "bold", size = 26, colour = ink,
                                            lineheight = 1.05, margin = margin(b = 12)),
        plot.subtitle = element_textbox_simple(size = 14, colour = muted,
                                               lineheight = 1.25, margin = margin(b = 40)),
        plot.caption = element_markdown(size = 9, colour = faint, hjust = 0,
                                        lineheight = 1.4, margin = margin(t = 20)),
        axis.text = element_blank(),
        panel.grid = element_blank(),
        plot.background = element_rect(fill = "white", color = NA))


#4. SAVE THE PLOT
ggsave("TT2024Week_31.png", p, width = 12, height = 8, dpi = 300, bg = "white")
ggsave("TT2024Week_31.svg", p, width = 12, height = 8, dpi = 300, bg = "white")
