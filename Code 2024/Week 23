# Cheese
# TidyTuesday 2024 · Week 23
# Question: what colour are the cheeses of the top cheese countries?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)
library(waffle)
library(ggh4x)      # force_panelsizes: lets the two rows of panels have different heights

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
cheeses <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-06-04/cheeses.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
# The UK appears under many names ("England", "England, Great Britain, United Kingdom",
# "Scotland", "Wales"...). Any entry made only of UK names becomes "United Kingdom".
uk <- "England|Scotland|Wales|Great Britain|United Kingdom|Northern Ireland"

colour_levels <- c("white", "pale white", "ivory", "cream", "pale yellow", "yellow",
                   "straw", "golden yellow", "orange", "blue", "Other")
yellows <- c("pale yellow", "yellow", "straw", "golden yellow")

base <- cheeses |>
  filter(!is.na(color), !is.na(country)) |>
  mutate(country = if_else(str_remove_all(country, paste0("(", uk, ")|,| ")) == "",
                           "United Kingdom", country),
         colour  = if_else(color %in% colour_levels, color, "Other"))

top_10 <- base |> count(country, sort = TRUE) |> slice_head(n = 10) |> pull(country)

dt <- base |>
  filter(country %in% top_10) |>
  count(country, colour) |>
  group_by(country) |>
  mutate(total = sum(n),
         yellow = sum(n[colour %in% yellows]) / total) |>
  ungroup() |>
  mutate(colour = factor(colour, levels = colour_levels)) |>
  arrange(country, colour)          # waffle fills in data order, so group by colour

# Strip label: country name + share of yellow cheeses
strip <- dt |> distinct(country, total, yellow) |> arrange(desc(total)) |>
  mutate(label = paste0("**", country, "**<br><span style='color:#7A7A7A'>",
                        round(yellow * 100), "% yellow · ", total, "</span>"))
dt <- dt |> mutate(country = factor(country, levels = strip$country, labels = strip$label))

nl        <- strip |> filter(country == "Netherlands")
yel_other <- base |> filter(country %in% top_10, country != "Netherlands") |>
  summarise(mean(colour %in% yellows)) |> pull()
n_all     <- sum(strip$total)

# Each row of panels is only as tall as its biggest waffle (12 squares per row of the waffle)
tile_rows <- strip |> mutate(row = if_else(row_number() <= 5, 1, 2), h = ceiling(total / 12)) |>
  group_by(row) |> mutate(h = max(h)) |> ungroup()
blank <- tibble(country = factor(strip$label, levels = strip$label), y = tile_rows$h + 0.5)
row_h <- unique(tile_rows$h)

# 4. COLOURS & TEXT --------------------------------------------------------
cols <- c(white = "#ECECEC", `pale white` = "#E4E1DA", ivory = "#F1E9C6", cream = "#EBD9B8",
          `pale yellow` = "#F7E2A2", yellow = "#F5CF3A", straw = "#D9B97A",
          `golden yellow` = "#E1AD01", orange = "#F08A3C", blue = "#5F8FA0", Other = "#9A8C8C")
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"; panel <- "white"

tt <- paste0(round(nl$yellow * 100), "% of Dutch cheeses are yellow, ",
             "the highest share of the top cheese countries")

st <- paste0(
  "Colour of ", n_all, " cheeses from the 10 countries with the most cheeses on cheese.com. ",
  "Each square is one cheese; the number after each country is its total. Across the other nine countries, ",
  round(yel_other * 100), "% are yellow and most are white or cream.")

ct <- paste0("Yellow = pale yellow, yellow, straw and golden yellow. Cheeses with no colour listed are left out; ",
             "England, Scotland and Wales are counted as the United Kingdom.<br>",
             "Data source: cheese.com · Creator: Zoi Diamantakou · TidyTuesday 2024 · Week 23")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(fill = colour, values = n)) +
  geom_waffle(colour = panel, size = 0.3, n_rows = 12, flip = TRUE,
              radius = unit(1.2, "pt"), na.rm = TRUE) +
  geom_blank(data = blank, aes(x = 1, y = y), inherit.aes = FALSE) +
  facet_wrap(~country, nrow = 2, scales = "free_y") +
  force_panelsizes(rows = row_h, cols = rep(12, 5), respect = TRUE) +
  scale_fill_manual(values = cols, name = NULL, drop = FALSE) +
  scale_x_continuous(expand = c(0, 0)) +
  scale_y_continuous(expand = c(0, 0)) +
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = NULL) +
  guides(fill = guide_legend(nrow = 2, keywidth = unit(3, "mm"), keyheight = unit(3, "mm"),
                             override.aes = list(colour = NA))) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 10)),
    plot.caption = element_textbox_simple(size = 7, colour = faint,
                                          lineheight = 1.4, margin = margin(t = 16)),
    legend.position = "top",
    legend.justification = "left",
    legend.location = "plot",
    legend.text = element_text(size = 7, colour = muted),
    legend.margin = margin(b = 8),
    strip.text = element_markdown(size = 7.5, colour = ink, hjust = 0, lineheight = 1.2,
                                  margin = margin(b = 4)),
    axis.text  = element_blank(),
    panel.grid = element_blank(),
    panel.background = element_rect(fill = panel, colour = NA),
    panel.spacing.x = unit(8, "pt"),
    panel.spacing.y = unit(12, "pt"),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week23.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2024Week23.svg", p, width = 7.5, height = 7.5, bg = "white")
