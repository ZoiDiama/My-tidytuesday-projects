# US Polling Places 2012-2020
# TidyTuesday 2024 · Week 3
# Question: which states have cut, or added, polling places since 2012?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(geofacet)   # only for the us_state_grid1 tile layout
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
polling_places <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-01-16/polling_places.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
# Change from the first to the last election with data in each state.
# States with a single election year (only 2020) cannot be compared.
change <- polling_places |>
  mutate(year = year(election_date)) |>
  count(state, year) |>
  arrange(state, year) |>
  group_by(state) |>
  summarise(n_years = n(),
            value = (last(n) - first(n)) / first(n) * 100, .groups = "drop") |>
  filter(n_years > 1)

groups <- c("Down more than 50%", "Down 10–50%", "Within ±10%",
            "Up 10–50%", "Up more than 50%")

dt <- as_tibble(as.data.frame(us_state_grid1)) |>
  filter(code != "DC") |>
  left_join(change, by = c("code" = "state")) |>
  mutate(
    group = case_when(
      is.na(value)  ~ NA_character_,
      value <= -50  ~ groups[1],
      value <= -10  ~ groups[2],
      value <   10  ~ groups[3],
      value <   50  ~ groups[4],
      TRUE          ~ groups[5]),
    group = factor(group, levels = groups),
    # show the number only where the change is large
    big   = !is.na(value) & abs(value) >= 40,
    pct   = if_else(value > 0, paste0("+", round(value), "%"),
                    paste0("−", abs(round(value)), "%")),
    y     = -row)          # top of the map at the top

n_down <- sum(change$value <= -10)
n_up   <- sum(change$value >=  10)
md     <- change |> filter(state == "MD") |> pull(value)
n_cmp  <- nrow(change)

# 4. COLOURS & TEXT --------------------------------------------------------
cols <- setNames(c("#C35E34", "#E7A877", "#F0ECD8", "#A7C2A4", "#448B81"), groups)
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"; nodata <- "#DCDCDC"

tt <- paste0("Maryland lost ", round(abs(md)), "% of its polling places between 2012 and 2020")

st <- paste0(
  "Change in the number of polling places by state, from the first to the last election ",
  "with data. ", n_down, " states cut more than 10% (",
  "<span style='color:", cols[1], "'>**orange**</span>); ", n_up, " added more than 10% (",
  "<span style='color:", cols[5], "'>**green**</span>). ",
  "Grey outline: no comparable data.")

ct <- paste0("Periods vary by state; 2020 includes pandemic-era changes to voting.<br>",
             "Data source: The Center for Public Integrity · Creator: Zoi Diamantakou · ",
             "TidyTuesday 2024 · Week 3")

# Legend drawn as a row of tiles under the subtitle
leg <- tibble(group = factor(groups, levels = groups),
              x = 1:5 * 1.25 + 3.4, y = -8.0)

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(col, y)) +
  # states without comparable data: outlined, empty
  geom_tile(data = filter(dt, is.na(group)), fill = "white", colour = nodata,
            linewidth = 0.5, width = 0.9, height = 0.9) +
  geom_tile(data = filter(dt, !is.na(group)), aes(fill = group),
            width = 0.9, height = 0.9) +
  # state codes (moved up a little when a % is shown underneath)
  geom_text(aes(y = y + if_else(big, 0.13, 0), label = code,
                colour = case_when(is.na(group) ~ "nodata",
                                   group %in% groups[c(1, 5)] ~ "light",
                                   TRUE ~ "dark")),
            family = "poppins", fontface = "bold", size = 3.4) +
  geom_text(data = filter(dt, big), aes(y = y - 0.2, label = pct),
            family = "poppins", size = 2.4, colour = "white") +
  # legend
  geom_tile(data = leg, aes(x, y, fill = group), width = 1.2, height = 0.24) +
  annotate("text", x = 4.0, y = -7.62, label = "Change in polling places", hjust = 0,
           family = "poppins", fontface = "bold", size = 2.3, colour = muted) +
  geom_text(data = leg, aes(x, y - 0.24, label = str_replace(group, " ", "\n")),
            family = "poppins", size = 2.1, colour = muted, vjust = 1, lineheight = 0.9) +
  scale_fill_manual(values = cols, guide = "none") +
  scale_colour_manual(values = c(light = "white", dark = ink, nodata = "#B5B5B5"),
                      guide = "none") +
  scale_x_continuous(expand = c(0, 0)) +
  scale_y_continuous(expand = c(0, 0)) +
  coord_equal(xlim = c(0.4, 11.6), ylim = c(-8.75, -0.45), clip = "off") +
  labs(title = tt, subtitle = st, caption = ct) +
  theme_void(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 14)),
    plot.caption = element_markdown(size = 7, colour = faint, hjust = 0,
                                    lineheight = 1.4, margin = margin(t = 18)),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week3.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2024Week3.svg", p, width = 7.5, height = 7.5, bg = "white")
