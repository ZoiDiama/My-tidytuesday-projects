# Valentine's Day Consumer Data
# TidyTuesday 2024 · Week 7
# Question: do men and women buy different Valentine's gifts?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(ggalluvial)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
gifts_gender <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-02-13/gifts_gender.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
# Values = % of each gender planning to buy that gift (people can buy several).
# The bars show each gift's share of all gift plans, so each bar adds to 100%.
gift_lab <- c(Flowers = "Flowers", Candy = "Candy", GreetingCards = "Greeting cards",
              EveningOut = "Evening out", Jewelry = "Jewellery", Clothing = "Clothing",
              GiftCards = "Gift cards")

dt <- gifts_gender |>
  pivot_longer(Candy:GiftCards, names_to = "gift", values_to = "buy") |>
  group_by(Gender) |>
  mutate(share = buy / sum(buy) * 100) |>
  ungroup() |>
  mutate(gift = factor(gift, levels = names(gift_lab), labels = gift_lab))

men_fl   <- dt |> filter(Gender == "Men",   gift == "Flowers") |> pull(buy)
women_fl <- dt |> filter(Gender == "Women", gift == "Flowers") |> pull(buy)
men_ca   <- dt |> filter(Gender == "Men",   gift == "Candy") |> pull(buy)
women_ca <- dt |> filter(Gender == "Women", gift == "Candy") |> pull(buy)

# 4. COLOURS & TEXT --------------------------------------------------------
# Palette: "Tuscan Sunset" (Adobe Color), colours sampled from the swatches
cols <- c(Flowers          = "#C75E34",  # terracotta
          Candy            = "#898043",  # olive green
          `Greeting cards` = "#CA847A",  # dusty rose
          `Evening out`    = "#E4A743",  # warm gold
          Jewellery        = "#F29F67",  # apricot
          Clothing         = "#F5C8C3",  # blush pink
          `Gift cards`     = "#C9C49C")  # light olive (tint of the olive)
dark <- c("Flowers", "Candy")
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("On Valentine's Day, ", men_fl, "% of men buy flowers, but only ",
             women_fl, "% of women do")

st <- paste0(
  "Share of US shoppers who plan to buy each Valentine's gift, by gender. Bar sizes compare gifts within each gender. ",
  "<span style='color:", cols["Flowers"], "'>**Flowers**</span> are the top gift for men; ",
  "women favour <span style='color:", cols["Candy"], "'>**candy**</span> and ",
  "<span style='color:#B0665C'>**greeting cards**</span>.")

ct <- paste0("Survey averages, 2010–2022. Shoppers can plan several gifts.<br>",
             "Data source: National Retail Federation, Valentine's Day Data Center · ",
             "Creator: Zoi Diamantakou · TidyTuesday 2024 · Week 7")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(x = Gender, y = share, fill = gift, alluvium = gift, stratum = gift)) +
  geom_flow(alpha = 0.5, curve_type = "cubic", width = 0.32, colour = "white",
            linewidth = 0.3) +
  geom_stratum(width = 0.32, colour = "white", linewidth = 0.6) +
  geom_text(stat = "stratum", aes(label = paste0(buy, "%"),
                                  colour = after_stat(stratum) %in% dark),
            family = "poppins", size = 2.9, fontface = "bold") +
  # gift names on the left
  geom_text(data = filter(dt, Gender == "Men"), stat = "stratum",
            aes(label = gift), nudge_x = -0.2, hjust = 1, family = "poppins",
            size = 2.8, colour = muted) +
  scale_fill_manual(values = cols, guide = "none") +
  scale_colour_manual(values = c(`TRUE` = "white", `FALSE` = ink), guide = "none") +
  scale_x_discrete(position = "top", expand = expansion(add = c(0.75, 0.25))) +
  scale_y_continuous(expand = c(0, 0)) +
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = NULL) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 16)),
    plot.caption = element_markdown(size = 7, colour = faint, hjust = 0,
                                    lineheight = 1.4, margin = margin(t = 16)),
    axis.text.x = element_text(size = 10, colour = ink, face = "bold"),
    axis.text.y = element_blank(),
    panel.grid  = element_blank(),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week7.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2024Week7.svg", p, width = 7.5, height = 7.5, bg = "white")
