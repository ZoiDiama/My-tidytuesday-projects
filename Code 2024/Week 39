# International Mathematical Olympiad (IMO)
# TidyTuesday 2024 · Week 39
# Question: which countries lead the Maths Olympiad?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(ggbump)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
country_results_df <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-09-24/country_results_df.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
short <- c("United States of America" = "United States", "People's Republic of China" = "China",
           "Republic of Korea" = "South Korea", "Russian Federation" = "Russia",
           "United Kingdom" = "UK", "Islamic Republic of Iran" = "Iran")

ranks <- country_results_df |>
  filter(year >= 2014) |>
  mutate(score = rowSums(across(p1:p6), na.rm = TRUE)) |>
  group_by(year) |>
  mutate(rank = min_rank(desc(score))) |>     # tied teams share a rank
  ungroup() |>
  mutate(country = coalesce(short[country], country))

# The 10 best teams of 2024, followed back to 2014
top_10 <- ranks |> filter(year == 2024) |> slice_min(rank, n = 10, with_ties = FALSE) |> pull(country)
dt <- ranks |> filter(country %in% top_10)

leaders <- c("United States", "China", "South Korea")
winners <- ranks |> filter(rank == 1)
us_cn   <- winners |> filter(country %in% c("United States", "China")) |> distinct(year) |> nrow()
n_years <- n_distinct(ranks$year)

# 4. COLOURS & TEXT --------------------------------------------------------
cols <- c(`United States` = "#0057B8", China = "#D62828", `South Korea` = "#2A9D8F")
grey <- "#D3D3D3"
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

dt <- dt |> mutate(col = coalesce(cols[country], grey),
                   lead = country %in% leaders)

tt <- paste0("China or the US has won the Maths Olympiad in ",
             us_cn, " of the last ", n_years, " years")

st <- paste0(
  "Team rank at the International Mathematical Olympiad, 2014–2024, for the 10 best teams of 2024. ",
  "<span style='color:", cols["China"], "'>**China**</span>, ",
  "<span style='color:", cols["United States"], "'>**the United States**</span> and ",
  "<span style='color:", cols["South Korea"], "'>**South Korea**</span> are almost always in the top 3; ",
  "South Korea's 2017 win is the only exception.")

ct <- paste0("Rank by the team's total score (six students, six problems). Tied teams share a rank, ",
             "e.g. China and the US in 2019. 2020 and 2021 were held online. Lines below 20th place run off the chart.<br>",
             "Data source: International Mathematical Olympiad (imo-official.org) · ",
             "Creator: Zoi Diamantakou · TidyTuesday 2024 · Week 39")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(year, rank, group = country)) +
  geom_bump(data = filter(dt, !lead), colour = grey, linewidth = 0.8, smooth = 6) +
  geom_point(data = filter(dt, !lead), colour = grey, size = 2) +
  geom_bump(data = filter(dt, lead), aes(colour = country), linewidth = 1.4, smooth = 6) +
  geom_point(data = filter(dt, lead), aes(colour = country), size = 5.2) +
  geom_text(data = filter(dt, lead), aes(label = rank), colour = "white",
            family = "poppins", fontface = "bold", size = 2.3) +
  # country names at the right (2024 rank order)
  geom_text(data = filter(dt, year == 2024, lead),
            aes(x = 2024.35, y = c(`United States` = 0.6, China = 1.9, `South Korea` = 3.2)[country],
                label = country, colour = country),
            hjust = 0, family = "poppins", fontface = "bold", size = 2.9) +
  annotate("text", x = 2024.35, y = 6.5, label = "Other top-10\nteams of 2024", hjust = 0,
           family = "poppins", size = 2.5, colour = "#9A9A9A", lineheight = 1) +
  scale_colour_manual(values = cols, guide = "none") +
  scale_y_reverse(breaks = c(1, 3, 5, 10, 15, 20)) +
  scale_x_continuous(breaks = 2014:2024, labels = c("2014", paste0("’", 15:24)),
                     expand = expansion(add = c(0.3, 1.8))) +
  coord_cartesian(ylim = c(20, 0.4), clip = "on") +   # ranks below 20 run off the bottom
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = "Rank") +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 16)),
    plot.caption = element_textbox_simple(size = 7, colour = faint,
                                          lineheight = 1.4, margin = margin(t = 16)),
    axis.title.y = element_text(size = 7.5, colour = faint, hjust = 1),
    axis.text  = element_text(size = 7.5, colour = faint),
    panel.grid = element_blank(),
    panel.grid.major.y = element_line(colour = "#EFEFEF", linewidth = 0.3),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week39.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2024Week39.svg", p, width = 7.5, height = 7.5, bg = "white")
