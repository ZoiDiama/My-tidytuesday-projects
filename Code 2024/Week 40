# Chess Game Dataset (Lichess)
# TidyTuesday 2024 · Week 40
# Question: which popular openings favour white, and which favour black?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
chess <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-10-01/chess.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
# The 15 most-played openings (by name, which is easier to read than the ECO code)
top_15 <- chess |> count(opening_name, sort = TRUE) |> slice_head(n = 15) |> pull(opening_name)

dt <- chess |>
  filter(opening_name %in% top_15) |>
  group_by(opening_name) |>
  summarise(games = n(),
            white = mean(winner == "white") * 100,
            black = mean(winner == "black") * 100,
            .groups = "drop") |>
  mutate(gap = white - black,
         label = paste0(opening_name, " <span style='color:#7A7A7A'>(", games, ")</span>"),
         label = fct_reorder(label, gap))

long <- dt |> pivot_longer(c(white, black), names_to = "side", values_to = "pct")

best_w <- dt |> slice_max(white, n = 1)
best_b <- dt |> slice_max(black, n = 1)
n_games <- sum(dt$games)

# 4. COLOURS & TEXT --------------------------------------------------------
bg <- "#F2E0D5"; dark <- "#252940"; rose <- "#A66F6F"
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("White wins ", round(best_w$white), "% after the ", best_w$opening_name,
             ", but only ", round(dt$white[dt$opening_name == best_b$opening_name]), "% after ",
             str_remove(best_b$opening_name, " Opening"))

st <- paste0(
  "Share of games won by **white** (open dots) and by ",
  "<span style='color:", dark, "'>**black**</span> (filled dots) in the 15 most-played openings on Lichess ",
  "(", scales::comma(n_games), " games; number of games in brackets). ",
  "Openings with a <span style='color:", rose, "'>**pink bar**</span> favour white, ",
  "those with a <span style='color:#6E6E78'>**grey bar**</span> favour black.")

ct <- paste0("Draws (about 4% of games) make up the rest. Casual and rated games, all ratings.<br>",
             "Data source: Lichess.org via Kaggle (Mitchell J.) · Creator: Zoi Diamantakou · ",
             "TidyTuesday 2024 · Week 40")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(long, aes(pct, label)) +
  geom_vline(xintercept = 50, colour = muted, linewidth = 0.3, linetype = "dashed") +
  geom_segment(data = dt, aes(x = black, xend = white, y = label, yend = label,
                              colour = gap > 0), linewidth = 1.6, alpha = 0.6) +
  geom_point(aes(fill = side), shape = 21, size = 4, stroke = 0.9, colour = dark) +
  geom_text(data = long |> filter(label == levels(dt$label)[15]),
            aes(label = paste0(round(pct), "%")),
            nudge_y = 0.55, family = "poppins", size = 2.5, colour = muted) +
  annotate("text", x = 50.5, y = 0.4, label = "50%", hjust = 0, family = "poppins",
           size = 2.4, colour = muted) +
  scale_fill_manual(values = c(white = "white", black = dark), guide = "none") +
  scale_colour_manual(values = c(`TRUE` = rose, `FALSE` = dark), guide = "none") +
  scale_x_continuous(limits = c(30, 68), breaks = seq(30, 65, 5),
                     labels = \(x) paste0(x, "%"), position = "top") +
  coord_cartesian(clip = "off") +
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = NULL) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 14)),
    plot.caption = element_textbox_simple(size = 7, colour = faint,
                                          lineheight = 1.4, margin = margin(t = 16)),
    axis.text.y = element_markdown(size = 8, colour = ink),
    axis.text.x = element_text(size = 7.5, colour = faint),
    panel.grid  = element_blank(),
    panel.grid.major.y = element_line(colour = "#E6CFC1", linewidth = 0.3),
    plot.background = element_rect(fill = bg, colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week40.png", p, width = 7.5, height = 7.5, dpi = 288, bg = bg)
ggsave("TT2024Week40.svg", p, width = 7.5, height = 7.5, bg = bg)
