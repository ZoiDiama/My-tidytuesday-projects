# American Idol
# TidyTuesday 2024 · Week 30
# Question: how has American Idol's audience changed over the seasons?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
ratings <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-07-23/ratings.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
dt <- ratings |>
  filter(!is.na(viewers_in_millions)) |>
  select(season, show_number, viewers = viewers_in_millions)

seasons <- dt |> group_by(season) |>
  summarise(avg = mean(viewers), .groups = "drop") |>
  mutate(label = paste0("Season ", season, "  <span style='color:#7A7A7A'>",
                        round(avg, 1), "m</span>"))
peak <- seasons |> slice_max(avg, n = 1)
last <- seasons |> slice_max(season, n = 1)
drop <- 1 - last$avg / peak$avg

dt <- dt |> left_join(seasons |> select(season, label, avg), by = "season") |>
  mutate(label = factor(label, levels = seasons$label),
         is_peak = season == peak$season)

# 4. COLOURS & TEXT --------------------------------------------------------
blue <- "#2B6CB0"; light <- "#A9C4E2"
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("American Idol has lost ", round(drop * 100), "% of its audience since its peak")

st <- paste0(
  "US viewers per episode, in millions, by season. Each bar is one episode; the grey number is ",
  "the season average. Viewing peaked in <span style='color:", blue, "'>**season ",
  peak$season, "**</span> at ", round(peak$avg, 1), " million and fell to ",
  round(last$avg, 1), " million by season ", last$season, ".")

ct <- paste0("Season 14 has no viewing data. Season averages are per episode.<br>",
             "Data source: Wikipedia, via kkakey/American_Idol",
             " · Creator: Zoi Diamantakou · TidyTuesday 2024 · Week 30")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(show_number, viewers, fill = is_peak)) +
  geom_col(width = 0.8) +
  geom_hline(aes(yintercept = avg), colour = ink, linewidth = 0.3, linetype = "22") +
  facet_wrap(~ label, ncol = 4) +
  scale_fill_manual(values = c(`TRUE` = blue, `FALSE` = light), guide = "none") +
  scale_x_continuous(breaks = c(1, 20, 40), expand = c(0, 0.5)) +
  scale_y_continuous(breaks = c(0, 20, 40), expand = c(0, 0)) +
  coord_cartesian(ylim = c(0, 45)) +
  labs(title = tt, subtitle = st, caption = ct, x = "Episode", y = NULL) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 18)),
    plot.caption = element_markdown(size = 7, colour = faint, hjust = 0,
                                    lineheight = 1.4, margin = margin(t = 16)),
    strip.text  = element_markdown(size = 7.5, colour = ink, hjust = 0),
    axis.title.x = element_text(size = 7, colour = faint, hjust = 0),
    axis.text   = element_text(size = 6, colour = faint),
    panel.grid  = element_blank(),
    panel.grid.major.y = element_line(colour = "#ECECEC", linewidth = 0.3),
    panel.spacing.x = unit(4, "mm"),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week30.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2024Week30.svg", p, width = 7.5, height = 7.5, bg = "white")
