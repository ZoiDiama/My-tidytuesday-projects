# Olympic Medals
# TidyTuesday 2024 · Week 32
# Question: which countries have won the most Olympic medals?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
olympics <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-08-06/olympics.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
# The data has one row per athlete, so a team gold (e.g. basketball) appears once
# per player. Keep each medal once: one per Games, event, country and medal.
medals <- olympics |>
  filter(!is.na(medal)) |>
  distinct(games, season, event, noc, medal)

names_noc <- c(USA = "United States", URS = "Soviet Union", GER = "Germany",
               GBR = "Great Britain", FRA = "France", ITA = "Italy", SWE = "Sweden",
               CHN = "China", RUS = "Russia", AUS = "Australia", CAN = "Canada",
               HUN = "Hungary", NOR = "Norway", JPN = "Japan")

top_10 <- medals |> count(noc, sort = TRUE) |> slice_head(n = 10)

dt <- medals |>
  filter(noc %in% top_10$noc) |>
  count(noc, medal) |>
  mutate(country = factor(names_noc[noc], levels = rev(names_noc[top_10$noc])),
         medal   = factor(medal, levels = c("Bronze", "Silver", "Gold")))

totals <- dt |> group_by(country) |> summarise(n = sum(n), .groups = "drop")

usa   <- top_10$n[top_10$noc == "USA"]
urs   <- top_10$n[top_10$noc == "URS"]
gold_usa <- dt |> filter(noc == "USA", medal == "Gold") |> pull(n) |> sum()
years <- range(olympics$year)
n_rows_raw <- olympics |> filter(!is.na(medal)) |> nrow()

# 4. COLOURS & TEXT --------------------------------------------------------
cols <- c(Gold = "#D6AF36", Silver = "#A7A7AD", Bronze = "#824A02")
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("The US has won ", scales::comma(usa),
             " Olympic medals, more than twice any other country")

st <- paste0(
  "Medals won by the 10 most successful countries at the Summer and Winter Olympics combined, ",
  years[1], "–", years[2], ", split into <span style='color:#B8922A'>**gold**</span>, ",
  "<span style='color:#8A8A92'>**silver**</span> and <span style='color:", cols["Bronze"],
  "'>**bronze**</span>. ", scales::comma(gold_usa), " of the US medals are gold; ",
  "the Soviet Union, second, won ", scales::comma(urs), " medals in all.")

ct <- paste0("Team medals counted once, not once per athlete. Germany excludes East and West Germany (1968–1988), ",
             "which competed separately.<br>",
             "Data source: 120 years of Olympic history (Kaggle, RGriffin) · Creator: Zoi Diamantakou · ",
             "TidyTuesday 2024 · Week 32")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(n, country, fill = medal)) +
  geom_col(width = 0.68, colour = "white", linewidth = 0.3) +
  geom_text(data = totals, aes(n, country, label = scales::comma(n)), inherit.aes = FALSE,
            hjust = 0, nudge_x = 30, family = "poppins", size = 2.7, colour = ink) +
  scale_fill_manual(values = cols, guide = "none") +
  scale_x_continuous(expand = expansion(mult = c(0, 0.1)), labels = scales::comma) +
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = NULL) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 16)),
    plot.caption = element_textbox_simple(size = 7, colour = faint,
                                          lineheight = 1.4, margin = margin(t = 16)),
    strip.text  = element_text(size = 10, colour = ink, face = "bold", hjust = 0),
    axis.text.y = element_text(size = 8.5, colour = ink),
    axis.text.x = element_text(size = 7, colour = faint),
    panel.grid  = element_blank(),
    panel.grid.major.x = element_line(colour = "#EFEFEF", linewidth = 0.3),
    panel.spacing.x = unit(20, "pt"),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week32.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2024Week32.svg", p, width = 7.5, height = 7.5, bg = "white")
