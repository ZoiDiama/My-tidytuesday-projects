# The Great American Coffee Taste Test
# TidyTuesday 2024 · Week 20
# Question: does people's favourite coffee change with age?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
coffee_survey <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-05-14/coffee_survey.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
ages <- c("<18 years old", "18-24 years old", "25-34 years old", "35-44 years old",
          "45-54 years old", "55-64 years old", ">65 years old")
age_lab <- c("Under 18", "18–24", "25–34", "35–44", "45–54", "55–64", "65+")
drinks <- c("Pourover", "Latte", "Regular drip coffee", "Cappuccino", "Espresso",
            "Cortado", "Americano", "Other")

dt <- coffee_survey |>
  filter(!is.na(age), !is.na(favorite)) |>
  mutate(drink = if_else(favorite %in% drinks, favorite, "Other")) |>
  count(age, drink) |>
  complete(age, drink, fill = list(n = 0)) |>
  group_by(age) |>
  mutate(pct = n / sum(n) * 100, total = sum(n),
         top = pct == max(pct)) |>          # favourite drink in each age group
  ungroup() |>
  mutate(drink = factor(drink, levels = rev(drinks)),
         x = match(age, ages))

totals <- dt |> distinct(x, total) |> arrange(x)
n_all  <- sum(totals$total)

# 4. COLOURS & TEXT --------------------------------------------------------
low <- "#F6EFE9"; high <- "#6B3E2E"     # milk to espresso
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- "Pourover for most adults, lattes for teens, drip coffee for the over-55s"

st <- paste0(
  "Favourite drink of ", scales::comma(n_all), " people in the Great American Coffee Taste Test, ",
  "as % of each age group. Darker means more popular; the ",
  "<span style='color:#C0263E'>**outlined**</span> square is each group's favourite.")

ct <- paste0("Small groups: only ", totals$total[1], " people under 18 and ", totals$total[7],
             " over 65 took part. Other = mocha, cold brew, iced coffee and blended drinks.<br>",
             "Data source: Great American Coffee Taste Test (James Hoffmann, Cometeer) · ",
             "Creator: Zoi Diamantakou · TidyTuesday 2024 · Week 20")

x_lab <- paste0("**", age_lab, "**<br><span style='color:", faint, "'>",
                scales::comma(totals$total), " people</span>")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(x, drink)) +
  geom_tile(aes(fill = pct), colour = "white", linewidth = 1.2) +
  geom_tile(data = filter(dt, top), fill = NA, colour = "#C0263E",
            linewidth = 1, width = 0.92, height = 0.92) +
  geom_text(aes(label = round(pct), colour = pct > 20,
                fontface = if_else(top, "bold", "plain")),
            family = "poppins", size = 3) +
  scale_fill_gradient(low = low, high = high, guide = "none") +
  scale_colour_manual(values = c(`TRUE` = "white", `FALSE` = ink), guide = "none") +
  scale_x_continuous(breaks = 1:7, labels = x_lab, position = "top", expand = c(0, 0)) +
  scale_y_discrete(labels = c(`Regular drip coffee` = "Drip coffee"), expand = c(0, 0)) +
  coord_cartesian(clip = "off") +
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = NULL) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 20)),
    plot.caption = element_textbox_simple(size = 7, colour = faint,
                                          lineheight = 1.4, margin = margin(t = 16)),
    axis.text.x = element_markdown(size = 8, colour = ink, lineheight = 1.2),
    axis.text.y = element_text(size = 9, colour = ink),
    panel.grid  = element_blank(),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week20.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2024Week20.svg", p, width = 7.5, height = 7.5, bg = "white")
