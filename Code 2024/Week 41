# National Park Species
# TidyTuesday 2024 · Week 41
# Question: what kinds of species live in the 15 most-visited US national parks?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(treemapify)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
species <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-10-08/most_visited_nps_species_data.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
# All species confirmed present in each park. (The earlier version also dropped
# species with no "Abundance" value, which removed over a quarter of the records.)
groups <- c("Plants", "Invertebrates", "Vertebrates", "Microorganisms")

dt <- species |>
  filter(TaxonRecordStatus == "Active", ParkAccepted == TRUE, Occurrence == "Present") |>
  mutate(group = case_when(
    CategoryName %in% c("Vascular Plant", "Non-vascular Plant")                     ~ "Plants",
    CategoryName %in% c("Mammal", "Bird", "Reptile", "Amphibian", "Fish")           ~ "Vertebrates",
    CategoryName %in% c("Fungi", "Chromista", "Protozoa", "Bacteria")               ~ "Microorganisms",
    TRUE                                                                           ~ "Invertebrates")) |>
  count(ParkName, group, name = "n") |>
  group_by(ParkName) |>
  mutate(total = sum(n), pct = n / total) |>
  ungroup() |>
  mutate(group = factor(group, levels = groups),
         park  = str_remove(ParkName, " National Park") |>
                 str_replace("Great Smoky Mountains", "Great Smoky Mtns"))

# Parks ordered by number of species, with the count in the facet title
parks <- dt |> distinct(park, total) |> arrange(desc(total)) |>
  mutate(strip = paste0(park, "  ", scales::comma(total)))
dt <- dt |> left_join(parks |> select(park, strip), by = "park") |>
  mutate(strip = factor(strip, levels = parks$strip))

smoky <- parks |> slice(1); second <- parks |> slice(2)
n_plant_majority <- dt |> filter(group == "Plants", pct > 0.5) |> nrow()

boxes <- dt |>
  arrange(strip, group) |>
  group_by(strip) |>
  group_modify(~ treemapify(as.data.frame(mutate(.x, group = as.character(group))),
                            area = "n", layout = "fixed",
                            xlim = c(0, 1), ylim = c(0, 1)) |> as_tibble()) |>
  ungroup() |>
  mutate(group = factor(group, levels = groups),
         label = if_else(pct >= 0.12, scales::percent(pct, accuracy = 1), ""))

# 4. COLOURS & TEXT --------------------------------------------------------
cols <- c(Plants = "#5E9C5A", Invertebrates = "#E3B23C", Vertebrates = "#A8743F",
          Microorganisms = "#C9C3B6")
text_col <- c(Plants = "white", Invertebrates = "#1A1A1A", Vertebrates = "white",
              Microorganisms = "#1A1A1A")
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("In ", n_plant_majority, " of the 15 most-visited US parks, most known species are plants")

st <- paste0(
  "Species recorded in each park, by type: ",
  "<span style='color:", cols["Plants"], "'>**plants**</span>, ",
  "<span style='color:#B8891A'>**invertebrates**</span>, ",
  "<span style='color:", cols["Vertebrates"], "'>**vertebrates**</span> and ",
  "<span style='color:#9A9384'>**microorganisms**</span>. Parks are ranked by number of species. ",
  smoky$park, " stands out with ", scales::comma(smoky$total), ", eight times more than ",
  second$park, ".")

ct <- paste0("Great Smoky Mountains has run an all-species survey since 1998, so its insects, fungi and other small species are far better recorded.<br>",
             "Data source: National Park Service, NPSpecies",
             " · Creator: Zoi Diamantakou · TidyTuesday 2024 · Week 41")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(boxes) +
  geom_rect(aes(xmin = xmin, xmax = xmax, ymin = ymin, ymax = ymax, fill = group),
            colour = "white", linewidth = 0.5) +
  geom_text(aes(x = (xmin + xmax) / 2, y = (ymin + ymax) / 2, label = label, colour = group),
            family = "poppins", fontface = "bold", size = 2.3) +
  facet_wrap(~ strip, ncol = 5) +
  scale_fill_manual(values = cols, guide = "none") +
  scale_colour_manual(values = text_col, guide = "none") +
  scale_x_continuous(expand = c(0, 0)) +
  scale_y_continuous(expand = c(0, 0)) +
  coord_equal() +
  labs(title = tt, subtitle = st, caption = ct) +
  theme_void(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 10.5, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 16)),
    plot.caption = element_textbox_simple(size = 7, colour = faint,
                                          lineheight = 1.4, margin = margin(t = 16)),
    strip.text = element_text(size = 6.5, colour = ink, hjust = 0, margin = margin(b = 3)),
    panel.spacing.x = unit(3, "mm"),
    panel.spacing.y = unit(4, "mm"),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week_41.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2024Week_41.svg", p, width = 7.5, height = 7.5, bg = "white")
