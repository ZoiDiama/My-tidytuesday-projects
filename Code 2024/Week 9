# Leap Day
# TidyTuesday 2024 · Week 9
# Question: how many notable people were born, or died, on 29 February?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
base <- "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-02-27/"
births <- read_csv(paste0(base, "births.csv"), show_col_types = FALSE)
deaths <- read_csv(paste0(base, "deaths.csv"), show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
dt <- bind_rows(
  births |> transmute(year = year_birth, type = "Births"),
  deaths |> transmute(year = year_death, type = "Deaths")) |>
  filter(year >= 1900) |>
  count(year, type) |>
  mutate(y = if_else(type == "Births", n, -n))

n_b <- sum(dt$n[dt$type == "Births"])
n_d <- sum(dt$n[dt$type == "Deaths"])
top_b <- dt |> filter(type == "Births") |> slice_max(n, n = 1, with_ties = FALSE)

# 4. COLOURS & TEXT --------------------------------------------------------
cols <- c(Births = "#61678C", Deaths = "#BF7A87")
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("Twice as many notable people were born on 29 February as died on it")

st <- paste0(
  "Notable people on Wikipedia <span style='color:", cols["Births"], "'>**born**</span> (", n_b,
  ") or <span style='color:", cols["Deaths"], "'>**who died**</span> (", n_d,
  ") on a leap day, by year, 1900–2024. Leap days come only every fourth year, ",
  "so each bar is one leap day. The busiest was ", top_b$year, ", with ", top_b$n, " births.")

ct <- paste0("Only people with a Wikipedia entry are counted, so recent deaths and early births are under-represented.<br>",
             "Data source: Wikipedia · Creator: Zoi Diamantakou · TidyTuesday 2024 · Week 9")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(year, y, fill = type)) +
  geom_hline(yintercept = 0, colour = "#8A8A8A", linewidth = 0.4) +
  geom_col(width = 3.2) +
  geom_text(data = filter(dt, n >= 3), aes(y = y + if_else(type == "Births", 0.45, -0.45),
                                           label = n, colour = type),
            family = "poppins", size = 2.4, fontface = "bold") +
  annotate("text", x = 1898, y = c(7.5, -5.5), label = c("Born", "Died"), hjust = 0,
           family = "poppins", fontface = "bold", size = 3.4, colour = cols) +
  scale_fill_manual(values = cols, guide = "none") +
  scale_colour_manual(values = cols, guide = "none") +
  scale_x_continuous(breaks = seq(1900, 2020, 20)) +
  scale_y_continuous(breaks = seq(-6, 8, 2), labels = abs, limits = c(-6.5, 9)) +
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = NULL) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 18)),
    plot.caption = element_markdown(size = 7, colour = faint, hjust = 0,
                                    lineheight = 1.4, margin = margin(t = 16)),
    axis.text  = element_text(size = 7.5, colour = faint),
    panel.grid = element_blank(),
    panel.grid.major.y = element_line(colour = "#EFEFEF", linewidth = 0.3),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week9.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2024Week9.svg", p, width = 7.5, height = 7.5, bg = "white")
