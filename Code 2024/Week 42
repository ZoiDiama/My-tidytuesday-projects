# Southern Resident Killer Whale Encounters
# TidyTuesday 2024 · Week 42
# Question: when in the year do researchers encounter the Southern Resident orcas?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
orcas <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-10-15/orcas.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
# Count encounters per month and year. (The earlier version averaged encounter
# length and used abs() on durations; some end times are earlier than start
# times, so that turned data errors into very long encounters.)
dt <- orcas |>
  filter(!is.na(year), !is.na(date)) |>
  mutate(month = month(date)) |>
  count(year, month, name = "encounters") |>
  complete(year, month = 1:12, fill = list(encounters = 0)) |>
  mutate(season = case_when(month %in% c(12, 1, 2) ~ "Winter",
                            month %in% 3:5         ~ "Spring",
                            month %in% 6:8         ~ "Summer",
                            TRUE                   ~ "Autumn"),
         sept = month == 9)

monthly <- dt |> group_by(month) |> summarise(n = sum(encounters))
sept_total  <- monthly$n[monthly$month == 9]
other_avg   <- mean(monthly$n[monthly$month != 9])
years       <- range(dt$year)
n_sept_top  <- dt |> group_by(year) |> slice_max(encounters, n = 1, with_ties = FALSE) |>
  filter(month == 9) |> nrow()

# 4. COLOURS & TEXT --------------------------------------------------------
accent <- "#2F6F8F"; base <- "#C9D6DE"
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- "Killer whale encounters in the Salish Sea peak in September"

st <- paste0(
  "Encounters with the Southern Resident orcas recorded by the Center for Whale Research, by month, ",
  years[1], "–", years[2], ". ",
  "<span style='color:", accent, "'>**September**</span> had ", sept_total, " encounters in total, ",
  "about twice the average of any other month, and was the busiest month in ",
  n_sept_top, " of ", n_distinct(dt$year), " years.")

ct <- paste0("Data source: Center for Whale Research",
             " · Creator: Zoi Diamantakou · TidyTuesday 2024 · Week 42")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(month, encounters, fill = sept)) +
  geom_col(width = 0.75) +
  facet_wrap(~ year, ncol = 4) +
  scale_fill_manual(values = c(`TRUE` = accent, `FALSE` = base), guide = "none") +
  scale_x_continuous(breaks = 1:12, labels = c("J", "F", "M", "A", "M", "J",
                                               "J", "A", "S", "O", "N", "D"),
                     expand = c(0, 0.3)) +
  scale_y_continuous(breaks = seq(0, 20, 10), expand = c(0, 0)) +
  coord_cartesian(ylim = c(0, 24)) +
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = NULL) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 20)),
    plot.caption = element_text(size = 7, colour = faint, hjust = 0,
                                margin = margin(t = 18)),
    strip.text  = element_text(size = 8.5, face = "bold", colour = ink, hjust = 0),
    axis.text.x = element_text(size = 6, colour = faint),
    axis.text.y = element_text(size = 6.5, colour = faint),
    panel.grid  = element_blank(),
    panel.grid.major.y = element_line(colour = "#ECECEC", linewidth = 0.3),
    panel.spacing.x = unit(5, "mm"),
    panel.spacing.y = unit(6, "mm"),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week_42.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2024Week_42.svg", p, width = 7.5, height = 7.5, bg = "white")
