# 2023 & 2024 US Solar Eclipses
# TidyTuesday 2024 · Week 15
# Question: where in the US did the April 2024 total eclipse last longest?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(maps)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
eclipse_total_2024 <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-04-09/eclipse_total_2024.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
# Totality = time between eclipse_3 (total begins) and eclipse_4 (total ends)
dt <- eclipse_total_2024 |>
  mutate(seconds = as.numeric(eclipse_4 - eclipse_3)) |>
  arrange(seconds)                          # longest drawn on top

longest <- dt |> slice_max(seconds, n = 1, with_ties = FALSE)
fmt <- function(s) paste0(s %/% 60, " min ", s %% 60, " s")

# Base map: only the states in the eclipse path, plus neighbours for context
usa <- map_data("state")
path_states <- tolower(state.name[match(unique(dt$state), state.abb)])

# State labels for the states in the path
state_lab <- usa |>
  filter(region %in% path_states) |>
  group_by(region) |>
  summarise(long = mean(range(long)), lat = mean(range(lat)), .groups = "drop") |>
  mutate(code = state.abb[match(region, tolower(state.name))]) |>
  # small nudges so labels sit beside the path, not under the dots
  mutate(long = long + case_when(code %in% c("TX") ~ -2.5, code == "OK" ~ -2,
                                 code == "AR" ~ 0.6, code == "MO" ~ -1.2,
                                 code == "IL" ~ 1, code == "IN" ~ 1, code == "OH" ~ 1.2,
                                 code == "KY" ~ 1, TRUE ~ 0),
         lat  = lat + case_when(code == "AR" ~ -1.3, code == "NY" ~ -1.3, code == "VT" ~ 1.6, code == "ME" ~ 1.2,
                                code == "PA" ~ -0.6, TRUE ~ 0))

# 4. COLOURS & TEXT --------------------------------------------------------
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("The 2024 eclipse lasted longest in Texas: up to ", fmt(longest$seconds), " of darkness")

st <- paste0(
  "Length of totality on April 8, 2024, in ", scales::comma(nrow(dt)),
  " US places in the path of the total solar eclipse. ",
  "The longer the darkness, the darker the dot. It shortened as the shadow moved northeast ",
  "and towards the edges of the path.")

ct <- paste0("Data source: NASA's Scientific Visualization Studio",
             " · Creator: Zoi Diamantakou · TidyTuesday 2024 · Week 15")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot() +
  geom_polygon(data = usa, aes(long, lat, group = group),
               fill = "#F2F2F2", colour = "white", linewidth = 0.4) +
  geom_point(data = dt, aes(lon, lat, colour = seconds), size = 0.7, alpha = 0.85) +
  geom_text(data = state_lab, aes(long, lat, label = code), family = "poppins",
            fontface = "bold", size = 2.4, colour = "#9A9A9A") +
  # longest point
  geom_point(data = longest, aes(lon, lat), shape = 21, size = 3, stroke = 0.8,
             colour = ink, fill = NA) +
  annotate("richtext", x = longest$lon + 1.2, y = longest$lat - 0.6,
           label = paste0("**", fmt(longest$seconds), "**<br>", longest$name, ", TX"),
           hjust = 0, vjust = 1, family = "poppins", size = 2.5, colour = ink,
           lineheight = 1.2, fill = NA, label.colour = NA, label.padding = unit(0, "pt")) +
  scale_colour_gradient(low = "#F7D58B", high = "#1B2A4A",
                        breaks = c(60, 120, 180, 240),
                        labels = c("1 min", "2 min", "3 min", "4 min"),
                        name = "Totality") +
  coord_quickmap(xlim = c(-104, -66), ylim = c(25.5, 48), expand = FALSE) +
  labs(title = tt, subtitle = st, caption = ct) +
  guides(colour = guide_colourbar(barwidth = unit(45, "mm"), barheight = unit(2.5, "mm"),
                                  title.position = "left", title.vjust = 1)) +
  theme_void(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 10)),
    plot.caption = element_text(size = 7, colour = faint, hjust = 0,
                                margin = margin(t = 18)),
    legend.position = "top",
    legend.justification = "left",
    legend.location = "plot",
    legend.title = element_text(size = 7.5, colour = muted, margin = margin(r = 8)),
    legend.text  = element_text(size = 7, colour = muted),
    legend.margin = margin(b = 8),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week_15.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2024Week_15.svg", p, width = 7.5, height = 7.5, bg = "white")
