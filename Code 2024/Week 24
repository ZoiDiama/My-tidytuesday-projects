# R Consortium ISC Grants
# TidyTuesday 2024 · Week 8
# Question: do spring or fall grants get more money?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
isc_grants <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-02-20/isc_grants.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
# group: 1 = spring cycle, 2 = fall cycle
dt <- isc_grants |>
  mutate(cycle = if_else(group == 1, "Spring", "Fall")) |>
  group_by(year, cycle) |>
  summarise(n = n(), mean = mean(funded), .groups = "drop") |>
  mutate(year = factor(year),
         label = paste0("$", round(mean / 1000, 1), "k<br><span style='color:#7A7A7A'>",
                        n, if_else(n == 1, " grant", " grants"), "</span>"))

overall <- isc_grants |>
  mutate(cycle = if_else(group == 1, "Spring", "Fall")) |>
  group_by(cycle) |>
  summarise(n = n(), mean = mean(funded), median = median(funded))
fall   <- overall |> filter(cycle == "Fall")
spring <- overall |> filter(cycle == "Spring")

fall_wins <- dt |> select(year, cycle, mean) |> pivot_wider(names_from = cycle, values_from = mean) |>
  filter(!is.na(Fall), !is.na(Spring))
n_fall_higher <- sum(fall_wins$Fall > fall_wins$Spring)

# 4. COLOURS & TEXT --------------------------------------------------------
cols <- c(Spring = "#6393A6", Fall = "#733B36")
bg <- "#FBEFEB"; ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("Fall grants average $", scales::comma(round(fall$mean, -2)), ", spring grants $",
             scales::comma(round(spring$mean, -2)), ": timing barely matters")

st <- paste0(
  "Average amount awarded per project by the R Consortium's ISC grant programme, ",
  "by year and cycle. The bigger the circle, the bigger the average grant. ",
  "<span style='color:", cols["Fall"], "'>**Fall**</span> grants were larger in ", n_fall_higher,
  " of the ", nrow(fall_wins), " years with both cycles; ",
  "<span style='color:", cols["Spring"], "'>**spring**</span> grants won the rest.")

ct <- paste0("2023 had only a spring cycle. Medians are almost equal: $", scales::comma(round(fall$median)),
             " in fall and $", scales::comma(round(spring$median)), " in spring.<br>",
             "Data source: R Consortium Infrastructure Steering Committee (ISC) Grant Program · ",
             "Creator: Zoi Diamantakou · TidyTuesday 2024 · Week 8")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(year, 0, size = mean, colour = cycle)) +
  geom_vline(xintercept = seq(1.5, nlevels(dt$year) - 0.5, 1), colour = "white", linewidth = 0.8) +
  geom_hline(yintercept = 0, colour = "#595959", linewidth = 0.6) +
  geom_point(alpha = 0.5) +
  # spring labels above the line, fall labels below
  geom_richtext(data = filter(dt, cycle == "Spring"), aes(y = 0.1, label = label),
                size = 2.6, family = "poppins", fill = NA, label.colour = NA, lineheight = 1.1,
                show.legend = FALSE) +
  geom_richtext(data = filter(dt, cycle == "Fall"), aes(y = -0.1, label = label),
                size = 2.6, family = "poppins", fill = NA, label.colour = NA, lineheight = 1.1,
                show.legend = FALSE) +
  annotate("text", x = 0.45, y = c(0.1, -0.1), label = c("Spring", "Fall"), hjust = 1,
           family = "poppins", fontface = "bold", size = 3, colour = cols[c("Spring", "Fall")]) +
  scale_size_continuous(range = c(7, 30), guide = "none") +
  scale_colour_manual(values = cols, guide = "none") +
  scale_x_discrete(position = "top", expand = expansion(add = c(0.9, 0.5))) +
  scale_y_continuous(limits = c(-0.14, 0.14)) +
  coord_cartesian(clip = "off") +
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = NULL) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 10)),
    plot.caption = element_textbox_simple(size = 7, colour = faint,
                                          lineheight = 1.4, margin = margin(t = 10)),
    axis.text.x = element_text(size = 9, colour = ink, face = "bold"),
    axis.text.y = element_blank(),
    aspect.ratio = 0.55,
    panel.grid  = element_blank(),
    plot.background = element_rect(fill = bg, colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week8.png", p, width = 7.5, height = 7.5, dpi = 288, bg = bg)
ggsave("TT2024Week8.svg", p, width = 7.5, height = 7.5, bg = bg)
