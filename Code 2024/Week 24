# English Women's Football
# TidyTuesday 2024 · Week 29
# Question: which top-flight clubs score more goals than they concede?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)

# Poppins, the font used across all featured charts
font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
# Read straight from GitHub
ewf_standings <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-07-16/ewf_standings.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
clubs <- ewf_standings |>
  # Top flight only: tier 2 goals came against weaker opposition
  filter(tier == 1) |>
  # Many clubs renamed from "Ladies" to "Women" around 2018.
  # Strip the suffix so each club is counted once.
  mutate(club = team_name |>
           str_remove(" (Women|Ladies|Lionesses|Belles)$") |>
           str_replace("^Spurs$", "Tottenham Hotspur") |>
           str_replace("^Bristol Academy$", "Bristol City")) |>
  group_by(club) |>
  summarise(goals_for     = sum(goals_for, na.rm = TRUE),
            goals_against = sum(goals_against, na.rm = TRUE),
            seasons       = n(),
            titles        = sum(position == 1),
            .groups = "drop") |>
  mutate(goal_diff = goals_for - goals_against,
         positive  = goal_diff > 0,
         club      = fct_reorder(club, goal_diff))

n_clubs    <- nrow(clubs)
n_positive <- sum(clubs$positive)
first_season <- str_sub(min(ewf_standings$season), 1, 4)
last_season  <- str_replace(max(ewf_standings$season), "^(\\d{4})-\\d{2}(\\d{2})$", "\\1–\\2")

# Club labels: bold for the clubs in the black, muted for the rest
clubs <- clubs |>
  mutate(label = if_else(
    positive,
    paste0("<span style='color:#1A1A1A'>**", club, "**</span>"),
    paste0("<span style='color:#5A5A5A'>", club, "</span>")),
    gd_label = if_else(positive, paste0("+", goal_diff), as.character(goal_diff)))

# 4. COLOURS & TEXT --------------------------------------------------------
col_for     <- "#5B98A6"   # goals scored
col_against <- "#D94A4A"   # goals conceded
ink   <- "#1A1A1A"
muted <- "#5A5A5A"
faint <- "#7A7A7A"

tt <- paste0("Only ", n_positive, " of ", n_clubs,
             " top-flight clubs have scored more than they've conceded")

st <- paste0(
  "Total goals <span style='color:", col_for, "'>**scored**</span> and ",
  "<span style='color:", col_against, "'>**conceded**</span> by each club in ",
  "England's women's top flight, ", first_season, " to ", last_season, ". ",
  "Clubs renamed from \"Ladies\" to \"Women\" are counted once.")

ct <- paste0("Data source: The English Women's Football (EWF) Database",
             " · Creator: Zoi Diamantakou · TidyTuesday 2024 · Week 29")

# Where the dividing line between the two groups sits
split_y <- sum(!clubs$positive) + 0.5

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(clubs, aes(y = club)) +
  # divider between the clubs in the black and the rest
  geom_hline(yintercept = split_y, colour = "#BDBDBD", linewidth = 0.3,
             linetype = "dashed") +
  annotate("text", x = 600, y = split_y + 0.35, label = "Scored more than conceded",
           family = "poppins", fontface = "bold", size = 2.4, colour = ink, hjust = 1) +
  annotate("text", x = 600, y = split_y - 0.45, label = "Conceded more than scored",
           family = "poppins", size = 2.4, colour = muted, hjust = 1) +
  # dumbbells
  geom_segment(aes(x = goals_against, xend = goals_for, yend = club,
                   colour = positive), linewidth = 1.6, alpha = 0.35) +
  geom_point(aes(x = goals_against), colour = col_against, size = 2.4) +
  geom_point(aes(x = goals_for), colour = col_for, size = 2.4) +
  # goal difference, at the right
  geom_text(aes(x = 660, label = gd_label,
                colour = positive, fontface = if_else(positive, "bold", "plain")),
            family = "poppins", size = 2.5, hjust = 1) +
  annotate("text", x = 660, y = n_clubs + 0.9, label = "Goal\ndifference",
           family = "poppins", size = 2.2, colour = faint, hjust = 1, lineheight = 0.9) +
  scale_colour_manual(values = c(`TRUE` = col_for, `FALSE` = col_against),
                      guide = "none") +
  scale_y_discrete(labels = setNames(clubs$label, clubs$club),
                   expand = expansion(add = c(0.6, 1.4))) +
  scale_x_continuous(breaks = seq(0, 600, 100), limits = c(0, 665),
                     position = "top", expand = c(0, 0)) +
  coord_cartesian(clip = "off") +
  labs(title = tt, subtitle = st, caption = ct, x = "Total goals", y = NULL) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 18)),
    plot.caption = element_text(size = 7, colour = faint, hjust = 0,
                                margin = margin(t = 18)),
    axis.title.x = element_text(size = 8, colour = faint, hjust = 0,
                                margin = margin(b = 4)),
    axis.text.x  = element_text(size = 8, colour = faint),
    axis.text.y  = element_markdown(size = 8, hjust = 1),
    panel.grid   = element_blank(),
    panel.grid.major.x = element_line(colour = "#EDEDED", linewidth = 0.3),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
# 1080 x 1080 px, saved at 2x (2160 px) like the featured charts
ggsave("TT2024Week29_v2.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2024Week29_v2.svg", p, width = 7.5, height = 7.5, bg = "white")
