# The CIA World Factbook
# TidyTuesday 2024 · Week 43
# Question: in which countries do more people die each year than are born?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)
library(ggrepel)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
# Note: these are the CIA Factbook's 2014 country comparisons
# (via the {openintro} package), featured on TidyTuesday in 2024.
cia_factbook <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-10-22/cia_factbook.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
dt <- cia_factbook |>
  select(country, birth_rate, death_rate, population) |>
  drop_na() |>
  mutate(shrinking = death_rate > birth_rate) |>
  arrange(desc(population))          # big circles drawn first, small ones on top

n_all    <- nrow(dt)
n_shrink <- sum(dt$shrinking)

lab <- dt |>
  filter(country %in% c("Ukraine", "Bulgaria", "Germany", "Japan", "Russia",
                        "Niger", "Mali", "Uganda", "China", "India", "United States",
                        "Nigeria"))

# 4. COLOURS & TEXT --------------------------------------------------------
red  <- "#C0392B"; grey <- "#B9C3CC"
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("In ", n_shrink, " countries, more people die each year than are born")

st <- paste0(
  "Birth and death rates per 1,000 people in ", n_all, " countries and territories, ",
  "CIA World Factbook 2014. Circles are sized by population. ",
  "<span style='color:", red, "'>**Red**</span> countries sit below the line: ",
  "without migration, their population shrinks.")

ct <- paste0("Data source: CIA World Factbook (2014), via {openintro}",
             " · Creator: Zoi Diamantakou · TidyTuesday 2024 · Week 43")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(death_rate, birth_rate)) +
  geom_abline(slope = 1, intercept = 0, colour = "#8A8A8A", linewidth = 0.4) +
  annotate("text", x = 4.6, y = 5.25, label = "Births = deaths", angle = 13, hjust = 0,
           family = "poppins", size = 2.3, colour = faint) +
  annotate("text", x = 0.3, y = 48, label = "Growing", hjust = 0,
           family = "poppins", fontface = "bold", size = 3, colour = muted) +
  annotate("text", x = 19.7, y = 2.5, label = "Shrinking", hjust = 1,
           family = "poppins", fontface = "bold", size = 3, colour = red) +
  geom_point(aes(size = population, fill = shrinking), shape = 21,
             colour = "white", stroke = 0.3, alpha = 0.85) +
  geom_text_repel(data = lab, aes(label = country,
                                  colour = shrinking,
                                  fontface = if_else(shrinking, "bold", "plain")),
                  family = "poppins", size = 2.4, min.segment.length = 0,
                  segment.colour = "#9A9A9A", segment.size = 0.25,
                  box.padding = 0.5, max.overlaps = Inf, seed = 43) +
  scale_fill_manual(values = c(`TRUE` = red, `FALSE` = grey), guide = "none") +
  scale_colour_manual(values = c(`TRUE` = red, `FALSE` = ink), guide = "none") +
  scale_size_area(max_size = 16, breaks = c(1e7, 1e8, 5e8),
                  labels = c("10 million", "100 million", "500 million people"),
                  name = NULL) +
  scale_x_continuous(limits = c(0, 20), breaks = seq(0, 20, 5), expand = c(0, 0)) +
  scale_y_continuous(limits = c(0, 50), breaks = seq(0, 50, 10), expand = c(0, 0)) +
  coord_cartesian(clip = "off") +
  labs(title = tt, subtitle = st, caption = ct,
       x = "Deaths per 1,000 people", y = "Births per 1,000 people") +
  guides(size = guide_legend(override.aes = list(fill = grey, colour = "white"))) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 10)),
    plot.caption = element_text(size = 7, colour = faint, hjust = 0,
                                margin = margin(t = 18)),
    legend.position = "top",
    legend.justification = "left",
    legend.text  = element_text(size = 7.5, colour = muted),
    legend.margin = margin(b = 4),
    axis.title   = element_text(size = 8, colour = muted),
    axis.title.x = element_text(margin = margin(t = 8)),
    axis.title.y = element_text(margin = margin(r = 8)),
    axis.text    = element_text(size = 7.5, colour = faint),
    panel.grid   = element_line(colour = "#ECECEC", linewidth = 0.3),
    panel.grid.minor = element_blank(),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week_43.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2024Week_43.svg", p, width = 7.5, height = 7.5, bg = "white")
