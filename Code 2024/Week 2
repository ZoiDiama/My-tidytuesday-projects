# Canadian Hockey Players
# TidyTuesday 2024 · Week 2
# Question: are Canadian NHL players shorter or taller than players from elsewhere?

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(ggridges)
library(showtext)
library(ggtext)

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
nhl_rosters <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-01-09/nhl_rosters.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
# The roster has one row per player per season; keep each player once.
positions <- c(forwards = "Forwards", defensemen = "Defencemen", goalies = "Goalies")

dt <- nhl_rosters |>
  distinct(player_id, .keep_all = TRUE) |>
  filter(!is.na(height_in_centimeters), !is.na(birth_country)) |>
  mutate(origin   = if_else(birth_country == "CAN", "Canadian", "International"),
         position = factor(positions[position_type], levels = rev(positions)))

avg <- dt |> group_by(position, origin) |>
  summarise(mean = mean(height_in_centimeters), n = n(), .groups = "drop")
gap_goalie <- with(avg, mean[position == "Goalies" & origin == "International"] -
                        mean[position == "Goalies" & origin == "Canadian"])
n_players <- nrow(dt)
share_can <- mean(dt$origin == "Canadian")

# Average label at the right of each ridge
lab <- avg |> mutate(label = paste0(round(mean), " cm"))

# 4. COLOURS & TEXT --------------------------------------------------------
cols <- c(Canadian = "#C8102E", International = "#66736E")
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("International goalies stand ", round(gap_goalie), " cm taller than Canadian ones")

st <- paste0(
  "Height of every NHL player since 1917, by position: ",
  "<span style='color:", cols["Canadian"], "'>**born in Canada**</span> (",
  scales::percent(share_can, accuracy = 1), ") or ",
  "<span style='color:", cols["International"], "'>**born elsewhere**</span>. ",
  "Forwards and defencemen are almost the same height wherever they come from; ",
  "goalies are the exception. The line marks the median.")

ct <- paste0("Each of the ", scales::comma(n_players), " players counted once. International players ",
             "are more common in recent decades, when players in general got taller.<br>",
             "Data source: NHL API, via Statistics Canada · Creator: Zoi Diamantakou · ",
             "TidyTuesday 2024 · Week 2")

# 5. PLOT ------------------------------------------------------------------
p <- ggplot(dt, aes(height_in_centimeters, position, fill = origin, colour = origin)) +
  geom_density_ridges(scale = 0.9, alpha = 0.45, linewidth = 0.4,
                      quantile_lines = TRUE, quantiles = 0.5, bandwidth = 2) +
  geom_text(data = lab, aes(x = 205, y = as.numeric(position) + 0.25 +
                              if_else(origin == "Canadian", 0.17, 0), label = label),
            inherit.aes = FALSE, colour = cols[lab$origin], family = "poppins",
            fontface = "bold", size = 2.6, hjust = 0) +
  scale_fill_manual(values = cols, guide = "none") +
  scale_colour_manual(values = cols, guide = "none") +
  scale_x_continuous(limits = c(160, 212), breaks = seq(160, 200, 10),
                     labels = \(x) paste0(x, " cm"), expand = c(0, 0)) +
  scale_y_discrete(expand = expansion(add = c(0.1, 0.9))) +
  annotate("text", x = 205, y = 3.95, label = "Average", hjust = 0, family = "poppins",
           size = 2.4, colour = faint) +
  coord_cartesian(clip = "off") +
  labs(title = tt, subtitle = st, caption = ct, x = NULL, y = NULL) +
  theme_minimal(base_family = "poppins") +
  theme(
    plot.title.position   = "plot",
    plot.caption.position = "plot",
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 11, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 18)),
    plot.caption = element_markdown(size = 7, colour = faint, hjust = 0,
                                    lineheight = 1.4, margin = margin(t = 16)),
    axis.text.y = element_text(size = 9, colour = ink, face = "bold", vjust = 0),
    axis.text.x = element_text(size = 7.5, colour = faint),
    panel.grid  = element_blank(),
    panel.grid.major.x = element_line(colour = "#ECECEC", linewidth = 0.3),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(36, 36, 36, 36))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week2.png", p, width = 7.5, height = 7.5, dpi = 288, bg = "white")
ggsave("TT2024Week2.svg", p, width = 7.5, height = 7.5, bg = "white")
