# English Monarchs and Marriages
# TidyTuesday 2024 · Week 34
# Question: how big were the age gaps in English royal marriages?
# An experimental radial view: each ring is one marriage (856 at the centre,
# 1947 at the edge), and the angle around the circle is age at marriage.

# 1. LIBRARIES -------------------------------------------------------------
library(tidyverse)
library(showtext)
library(ggtext)
library(patchwork)   # titles span the full width even though the circle is square

font_add_google("Poppins", family = "poppins")
showtext_auto()
showtext_opts(dpi = 288)

# 2. DATA ------------------------------------------------------------------
marriages <- read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2024/2024-08-20/english_monarchs_marriages_df.csv",
  show_col_types = FALSE)

# 3. WRANGLING -------------------------------------------------------------
# Unknown ages are written as "–" or "?"; uncertain ones as "(?)".
dt <- marriages |>
  mutate(across(everything(), ~ na_if(.x, "–")),
         across(everything(), ~ na_if(.x, "?")),
         across(everything(), ~ str_remove(.x, "\\(\\?\\)"))) |>
  mutate(king  = suppressWarnings(as.numeric(king_age)),
         queen = suppressWarnings(as.numeric(consort_age)),
         year  = suppressWarnings(as.numeric(year_of_marriage))) |>
  filter(!is.na(king), !is.na(queen), !is.na(year)) |>
  arrange(year) |>
  mutate(gap  = king - queen,
         ring = row_number() + 18,          # +18 leaves a hole in the middle, so early rings are not squashed
         gap_group = cut(gap, c(-Inf, -0.5, 0.5, 10, 20, 30, Inf),
                         labels = c("Monarch younger", "Same age", "1–10 yrs", "11–20 yrs", "21–30 yrs", "30+ yrs")))

n_all   <- nrow(dt)
n_older <- sum(dt$gap > 0)
n_child <- sum(dt$queen < 16)
med_gap <- median(dt$gap)
widest  <- dt |> slice_max(gap, n = 1)

# 4. COLOURS & TEXT --------------------------------------------------------
bg <- "#EFE8DE"
gap_cols <- c(`Monarch younger` = "#B8C9C4", `Same age` = "#D9CFC1", `1–10 yrs` = "#E2B486",
              `11–20 yrs` = "#D07A3E", `21–30 yrs` = "#9E3A2A", `30+ yrs` = "#4A0F0F")
king_col <- "#B0101C"; queen_col <- "#0A9C8F"
ink <- "#1A1A1A"; muted <- "#5A5A5A"; faint <- "#7A7A7A"

tt <- paste0("English monarchs were older than their spouses in ", n_older, " of ", n_all, " marriages")

span <- \(txt, col) paste0("<span style='color:", col, "'>**", txt, "**</span>")
st <- paste0(
  "Each ring is one royal marriage, from 856 at the centre to 1947 at the edge. Going clockwise, ",
  "the dots mark the age of the ", span("spouse", queen_col), " and the ", span("monarch", king_col),
  " on the wedding day. The line's colour is the gap: monarch older by ",
  span("1–10", "#D99A5B"), ", ", span("11–20", gap_cols[["11–20 yrs"]]), ", ",
  span("21–30", gap_cols[["21–30 yrs"]]), " or ", span("30+ years", gap_cols[["30+ yrs"]]), ", or ",
  span("younger", "#7E9C95"), ". The typical gap was ", med_gap, " years; ", n_child,
  " spouses married before 16.")

ct <- paste0("Only marriages where both ages are known (", n_all, " of ", nrow(marriages), "). ",
             "Includes reigning queens (Mary I, Anne, Victoria, Elizabeth II).<br>",
             "Data source: IanVisits · Creator: Zoi Diamantakou · TidyTuesday 2024 · Week 34")

# 5. PLOT ------------------------------------------------------------------
max_ring <- max(dt$ring)
p <- ggplot(dt, aes(y = ring)) +
  # age spokes and their labels
  geom_vline(xintercept = seq(0, 60, 10), colour = "white", linewidth = 0.5) +
  geom_vline(xintercept = 16, colour = "#C9BBA8", linewidth = 0.4, linetype = "22") +
  annotate("text", x = seq(10, 60, 10), y = max_ring + 4, label = paste(seq(10, 60, 10), "yrs"),
           family = "poppins", size = 2.4, colour = faint) +
  annotate("text", x = 16, y = max_ring + 4, label = "16", family = "poppins", size = 2.2,
           colour = "#A8977F") +
  # the marriages
  geom_segment(aes(x = queen, xend = king, yend = ring, colour = gap_group),
               linewidth = 1.3, lineend = "round") +
  geom_point(aes(x = queen), colour = queen_col, size = 1.3) +
  geom_point(aes(x = king), colour = king_col, size = 1.3) +
  # first and last ring
  annotate("text", x = 0, y = c(19, max_ring), label = c("856", "1947"), hjust = 1.15,
           family = "poppins", fontface = "bold", size = 2.3, colour = muted) +
  scale_colour_manual(values = gap_cols, guide = "none") +
  scale_x_continuous(limits = c(0, 66), expand = c(0, 0)) +
  scale_y_continuous(limits = c(0, max_ring + 5), expand = c(0, 0)) +
  coord_polar(theta = "x", clip = "off") +
  theme_void(base_family = "poppins") +
  theme(legend.position = "top",
        legend.justification.top = "left",
        legend.location = "plot",
        legend.margin = margin(b = 0),
        legend.text = element_text(size = 7, colour = muted),
        legend.title = element_text(size = 7, colour = muted, face = "bold"),
        legend.key.width = unit(5, "mm"),
        legend.key.spacing.x = unit(3, "pt"),
        plot.margin = margin(0, 0, 0, 0))

p <- wrap_elements(full = p) + plot_annotation(
  title = tt, subtitle = st, caption = ct,
  theme = theme(
    text = element_text(family = "poppins"),
    plot.title = element_textbox_simple(face = "bold", size = 22, colour = ink,
                                        lineheight = 1.05, margin = margin(b = 12)),
    plot.subtitle = element_textbox_simple(size = 10.5, colour = muted,
                                           lineheight = 1.25, margin = margin(b = 10)),
    plot.caption = element_textbox_simple(size = 7, colour = faint,
                                          lineheight = 1.4, margin = margin(t = 6)),
    plot.background = element_rect(fill = bg, colour = NA),
    plot.margin = margin(36, 36, 36, 36)))
p <- p & theme(plot.background = element_rect(fill = bg, colour = NA))

# 6. SAVE ------------------------------------------------------------------
ggsave("TT2024Week_34.png", p, width = 7.5, height = 7.5, dpi = 288, bg = bg)
ggsave("TT2024Week_34.svg", p, width = 7.5, height = 7.5, bg = bg)
